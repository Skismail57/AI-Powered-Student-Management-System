                    <div class="p-2 rounded border bg-gray-50"><p class="text-gray-500">Attendance Delta</p><p class="font-semibold ${Number(k.attendance_delta || 0) < 0 ? 'text-red-600' : 'text-emerald-600'}">${k.attendance_delta ?? 0}</p></div>
                    <div class="p-2 rounded border bg-gray-50"><p class="text-gray-500">Weak Topics</p><p class="font-semibold">${k.weak_topics_count ?? 0}</p></div>
                `;
