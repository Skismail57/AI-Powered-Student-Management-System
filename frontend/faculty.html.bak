        async function loadFacultyAnalytics() {
            try {
                const res = await fetch(`${API_BASE}/faculty/analytics`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                
                const avgEl = document.getElementById('avgAttText');
                if (avgEl) avgEl.textContent = `${data.average_attendance}%`;
                
                const riskList = document.getElementById('riskStudentsList');
                if (riskList) {
                    riskList.innerHTML = data.risk_students.map(s => `
                        <div class="p-3 bg-red-50 border-l-4 border-red-500 rounded flex justify-between items-center">
                            <div>
                                <p class="font-bold text-sm">${s.name}</p>
                                <p class="text-xs text-gray-500">${s.dept_name || 'General'}</p>
                            </div>
                            <span class="text-red-700 font-bold">${s.attendance}%</span>
                        </div>
                    `).join('') || '<p class="text-gray-500 text-sm">No students at risk.</p>';
                }
                
                const quizList = document.getElementById('quizStatsList');
                if (quizList) {
                    quizList.innerHTML = data.quiz_stats.map(q => `
                        <div class="p-2 border-b text-sm flex justify-between">
