                    <!-- Pharmacy Department -->
                    <div class="department-card card-shadow" onclick="showDepartmentDetails('pharmacy')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-pills text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">220 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Pharmacy</h3>
                        <p class="text-sm text-gray-600 mb-3">Pharmaceutical sciences, drug development, clinical pharmacy</p>
                        <div class="flex items-center text-sm text-gray-500">
                            <i class="fas fa-book mr-2"></i>
                            <span>15 Courses</span>
                        </div>
