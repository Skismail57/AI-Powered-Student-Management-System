<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System - Faculty Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-blue: #1e40af;
            --light-blue: #3b82f6;
            --very-light-blue: #dbeafe;
            --dark-blue: #1e3a8a;
            --white: #ffffff;
            --gray-light: #f3f4f6;
            --gray-medium: #9ca3af;
            --gray-dark: #374151;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--gray-light);
            color: var(--gray-dark);
        }

        .gradient-bg {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--light-blue) 100%);
        }

        .card-shadow {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
        }

        .card-shadow:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            transform: translateY(-2px);
        }

        .sidebar-item {
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }

        .sidebar-item:hover {
            background-color: rgba(59, 130, 246, 0.1);
            border-left-color: var(--light-blue);
        }

        .sidebar-item.active {
            background-color: rgba(59, 130, 246, 0.15);
            border-left-color: var(--light-blue);
            color: var(--primary-blue);
        }

        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .slide-up {
            animation: slideUp 0.5s ease-out;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .chatbot-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }

        .chatbot-bubble {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }

        .chatbot-bubble:hover {
            transform: scale(1.1);
        }

        .chatbot-window {
            position: absolute;
            bottom: 80px;
            right: 0;
            width: 350px;
            height: 500px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            display: none;
            flex-direction: column;
            overflow: hidden;
        }

        .chatbot-header {
            background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
            color: white;
            padding: 15px;
            font-weight: 600;
        }

        .chatbot-messages {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            background: #f9fafb;
        }

        .chatbot-input {
            padding: 15px;
            border-top: 1px solid #e5e7eb;
            display: flex;
        }

        .chatbot-input input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #d1d5db;
            border-radius: 20px;
            outline: none;
        }

        .chatbot-input button {
            margin-left: 10px;
            padding: 8px 15px;
            background: var(--light-blue);
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .chatbot-input button:hover {
            background: var(--primary-blue);
        }

        .message {
            margin-bottom: 10px;
            padding: 10px 15px;
            border-radius: 18px;
            max-width: 80%;
        }

        .message.bot {
            background: #e5e7eb;
            align-self: flex-start;
        }

        .message.user {
            background: var(--light-blue);
            color: white;
            align-self: flex-end;
            margin-left: auto;
        }

        .stats-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(59, 130, 246, 0.05));
            border-radius: 0 0 0 100px;
        }

        .department-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .department-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: var(--light-blue);
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .department-card:hover::after {
            transform: scaleY(1);
        }

        .department-card:hover {
            transform: translateX(5px);
        }

        .table-hover tbody tr:hover {
            background-color: rgba(59, 130, 246, 0.05);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(59, 130, 246, 0.3);
        }

        .form-input {
            width: 100%;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 5px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-input:focus {
            border-color: var(--light-blue);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            border-radius: 10px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            animation: slideUp 0.3s ease-out;
        }

        .close-modal {
            float: right;
            font-size: 24px;
            cursor: pointer;
            color: #9ca3af;
        }

        .close-modal:hover {
            color: #374151;
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                position: fixed;
                z-index: 100;
                height: 100%;
                transition: transform 0.3s ease;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .menu-toggle {
                display: block;
            }
        }

        @media (min-width: 769px) {
            .menu-toggle {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="gradient-bg text-white shadow-lg">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <button class="menu-toggle text-white" onclick="toggleSidebar()">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
                <div class="flex items-center space-x-3">
                    <i class="fas fa-graduation-cap text-3xl"></i>
                    <h1 class="text-2xl font-bold">Student Management System</h1>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <div class="relative">
                    <button onclick="toggleNotificationsPanel()" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-3 py-2 rounded-lg transition">
                        <i class="fas fa-bell"></i>
                        <span id="notifBadge" class="ml-1 text-xs bg-red-500 px-1.5 py-0.5 rounded-full">0</span>
                    </button>
                    <div id="notifPanel" class="hidden absolute right-0 mt-2 w-80 bg-white text-gray-800 rounded-lg shadow-xl border z-50">
                        <div class="p-3 border-b flex items-center justify-between">
                            <p class="font-semibold text-sm">Notifications</p>
                            <div class="flex items-center gap-2">
                                <a href="notifications.html" class="text-xs text-indigo-600 hover:text-indigo-800">Open Center</a>
                                <button onclick="markAllNotificationsRead()" class="text-xs text-blue-600 hover:text-blue-800">Mark all read</button>
                            </div>
                        </div>
                        <div id="notifList" class="max-h-72 overflow-y-auto text-sm">
                            <p class="p-3 text-gray-500">Loading...</p>
                        </div>
                    </div>
                </div>
                <a href="search.html" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-3 py-2 rounded-lg transition text-sm">Search</a>
                <a href="messages.html" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-3 py-2 rounded-lg transition text-sm">Messages</a>
                <div class="text-right">
                    <p class="font-semibold" id="facultyName">Faculty User</p>
                    <p class="text-sm opacity-90">Faculty</p>
                </div>
                <img src="https://picsum.photos/seed/faculty/50/50" alt="Faculty" class="w-12 h-12 rounded-full border-2 border-white">
                <button id="logoutBtn" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-4 py-2 rounded-lg transition">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </header>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="sidebar w-64 bg-white shadow-lg min-h-screen">
            <nav class="p-4">
                <ul class="space-y-2">
                    <li>
                        <a href="#" onclick="showSection('dashboard')" class="sidebar-item active flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-tachometer-alt w-5"></i>
                            <span>Overview</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('students')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-users w-5"></i>
                            <span>Students</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('attendance')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-calendar-check w-5"></i>
                            <span>Mark Attendance</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('notes')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-file-alt w-5"></i>
                            <span>Study Materials</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('assignments')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-tasks w-5"></i>
                            <span>Assignments</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('lesson-planner')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-book-open w-5"></i>
                            <span>Lesson Planner</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('ai-generator')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-magic w-5"></i>
                            <span>AI Assignment Gen</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('voice-notes')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-microphone w-5"></i>
                            <span>Voice Notes</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('analytics')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-chart-line w-5"></i>
                            <span>Analytics</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('research')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-microscope w-5"></i>
                            <span>Research Portal</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('appointments')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-calendar-check w-5"></i>
                            <span>Appointments</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('placements-admin')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-briefcase w-5"></i>
                            <span>Placement Support</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('flashcards-admin')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-bolt w-5"></i>
                            <span>Flashcards Management</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('announcements')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-bullhorn w-5"></i>
                            <span>Announcements</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-6">
            <!-- Analytics Section -->
            <section id="analytics" class="content-section hidden fade-in">
                <h2 class="text-3xl font-bold mb-6 text-gray-800">Faculty Analytics & Insights</h2>
                
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                    <!-- Class Performance -->
                    <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-600">
                        <h3 class="text-lg font-bold mb-4 flex items-center">
                            <i class="fas fa-chart-bar mr-2 text-blue-600"></i> Class Performance
                        </h3>
                        <div class="flex items-center justify-between p-4 bg-blue-50 rounded-lg mb-4">
                            <span>Average Attendance</span>
                            <span id="avgAttText" class="text-2xl font-bold text-blue-700">--%</span>
                        </div>
                        <div id="quizStatsList" class="space-y-2">
                            <!-- Quiz stats here -->
                        </div>
                    </div>
                    
                    <!-- Topic-wise Analytics -->
                    <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-orange-500">
                        <h3 class="text-lg font-bold mb-4 flex items-center">
                            <i class="fas fa-exclamation-triangle mr-2 text-orange-500"></i> Topic-wise Difficulty Analysis
                        </h3>
                        <div id="topicAnalyticsList" class="space-y-4">
                            <!-- Dynamic topic analytics here -->
                        </div>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-red-600">
                    <h3 class="text-lg font-bold mb-4 flex items-center">
                        <i class="fas fa-user-clock mr-2 text-red-600"></i> Students At Risk (Low Attendance)
                    </h3>
                    <div id="riskStudentsList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <!-- Risk students here -->
                    </div>
                </div>
            </section>

            <!-- Lesson Planner Section -->
            <section id="lesson-planner" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Smart Lesson Planning</h2>
                    <button class="btn-primary" onclick="openModal('newLessonPlanModal')">
                        <i class="fas fa-plus mr-2"></i>Add Topic Plan
                    </button>
                </div>
                <div id="lessonPlansGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Dynamic lesson plans here -->
                </div>
            </section>

            <!-- AI Assignment Generator Section -->
            <section id="ai-generator" class="content-section hidden fade-in">
                <h2 class="text-3xl font-bold mb-6 text-gray-800">AI Assignment Generator</h2>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-magic-purple h-fit">
                        <h3 class="text-xl font-bold mb-4">Generator Settings</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium mb-1">Topic/Subject</label>
                                <input type="text" id="aiGenTopic" class="form-input" placeholder="e.g. Neural Networks">
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1">Difficulty Level</label>
                                <select id="aiGenDifficulty" class="form-input">
                                    <option value="basic">Basic (Undergrad)</option>
                                    <option value="intermediate">Intermediate (Graduate)</option>
                                    <option value="advanced">Advanced (PhD/Research)</option>
                                </select>
                            </div>
                            <button onclick="generateAIQuestions()" class="w-full py-3 bg-indigo-600 text-white rounded-lg font-bold hover:bg-indigo-700 transition">
                                <i class="fas fa-robot mr-2"></i> Generate Questions
                            </button>
                        </div>
                    </div>
                    <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow-md min-h-[400px]">
                        <h3 class="text-xl font-bold mb-4">Generated Content</h3>
                        <div id="aiGeneratedOutput" class="space-y-4">
                            <p class="text-gray-500 text-center py-20">Set parameters and click generate to see AI-suggested questions.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Voice Notes Section -->
            <section id="voice-notes" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Voice Notes & Lecture Recordings</h2>
                    <button class="btn-primary bg-red-600 hover:bg-red-700" onclick="openModal('uploadVoiceModal')">
                        <i class="fas fa-microphone mr-2"></i> Upload Recording
                    </button>
                </div>
                <div id="voiceNotesGrid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Dynamic voice notes here -->
                </div>
            </section>

            <!-- Assignments Section -->
            <section id="assignments" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Assignments</h2>
                    <button class="btn-primary" onclick="openCreateAssignmentModal()">
                        <i class="fas fa-plus mr-2"></i>Create Assignment
                    </button>
                </div>
                <div id="facultyAssignmentsList" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Dynamic assignments here -->
                </div>
            </section>

            <!-- Dashboard Section -->
            <section id="dashboard" class="content-section fade-in">
                <h2 class="text-3xl font-bold mb-6 text-gray-800">Dashboard Overview</h2>
                
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Total Students</p>
                                <p class="text-3xl font-bold text-blue-600">2,845</p>
                                <p class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-arrow-up"></i> 12% from last month
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-user-graduate"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Departments</p>
                                <p class="text-3xl font-bold text-blue-600">10</p>
                                <p class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-check"></i> All active
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-building"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Courses</p>
                                <p class="text-3xl font-bold text-blue-600">156</p>
                                <p class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-arrow-up"></i> 8 new this semester
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-book"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Faculty Members</p>
                                <p class="text-3xl font-bold text-blue-600">124</p>
                                <p class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-arrow-up"></i> 5 new hires
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-chalkboard-teacher"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Attendance Marking -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-green-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-user-check text-green-500 mr-2"></i> Quick Attendance Marking
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
                        <input id="attStudentId" class="form-input" placeholder="Student ID" />
                        <input id="attDate" type="date" class="form-input" />
                        <select id="attStatus" class="form-input">
                            <option value="present">Present</option>
                            <option value="absent">Absent</option>
                        </select>
                        <select id="attReason" class="form-input">
                            <option value="">No reason</option>
                            <option value="sick">Sick</option>
                            <option value="personal">Personal</option>
                            <option value="other">Other</option>
                        </select>
                        <button onclick="markAttendanceWithReason()" class="btn-primary">
                            <i class="fas fa-save mr-2"></i>Mark
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-2">Tip: reason is mainly useful when status is Absent.</p>
                </div>

                <!-- Decision Support Dashboard -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-violet-500">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xl font-semibold flex items-center">
                            <i class="fas fa-brain text-violet-500 mr-2"></i> Decision Support
                        </h3>
                        <button onclick="loadDecisionSupportPanel()" class="text-sm px-2 py-1 border rounded hover:bg-gray-50">Refresh</button>
                    </div>
                    <div id="decisionSupportKpis" class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm mb-3">
                        <div class="p-2 rounded border bg-gray-50">Loading KPIs...</div>
                    </div>
                    <div class="mb-3 p-3 rounded border bg-slate-50">
                        <div class="flex items-center justify-between mb-2">
                            <p class="text-sm font-semibold text-slate-800">Completed Actions (last 7 days)</p>
                            <p id="decisionActionsTotal7d" class="text-xs px-2 py-1 rounded bg-emerald-100 text-emerald-700">--</p>
                        </div>
                        <div id="decisionActionsTrend7d" class="flex items-end gap-1 h-12"></div>
                        <div id="decisionActionsRecent" class="mt-2 text-xs text-gray-600 space-y-1">
                            <p>Loading action history...</p>
                        </div>
                    </div>
                    <div id="decisionSupportList" class="space-y-2 text-sm text-gray-700">
                        <p>Loading recommendations...</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-slate-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-paper-plane text-slate-500 mr-2"></i> Quick Message
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                        <select id="quickMsgRole" class="form-input">
                            <option value="student">student</option>
                            <option value="parent">parent</option>
                            <option value="faculty">faculty</option>
                            <option value="admin">admin</option>
                        </select>
                        <input id="quickMsgRecipientId" type="number" min="1" class="form-input" placeholder="Recipient ID" />
                        <input id="quickMsgBody" class="form-input md:col-span-2" placeholder="Type message..." />
                    </div>
                    <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2">
                        <select id="quickMsgRecentContacts" class="form-input" onchange="applyFacultyRecentContact(this.value)">
                            <option value="">Recent contacts</option>
                        </select>
                        <p id="quickMsgUnreadCount" class="text-xs text-gray-500 self-center">Unread in thread: 0</p>
                    </div>
                    <div class="mt-2">
                        <input id="quickMsgThreadSearch" oninput="renderFacultyThread()" class="form-input" placeholder="Search in this thread..." />
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <button onclick="sendQuickMessage()" class="btn-primary">Send</button>
                        <button onclick="loadQuickMessageThread()" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Load thread</button>
                        <button onclick="exportFacultyThreadCsv()" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Export thread CSV</button>
                        <a href="messages.html" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Open full inbox</a>
                        <p id="quickMsgStatus" class="text-xs text-gray-500"></p>
                    </div>
                    <div id="quickMsgThread" class="mt-3 max-h-56 overflow-y-auto space-y-2 text-sm">
                        <p class="text-gray-500">Select role + ID and load thread.</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-indigo-400">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-search text-indigo-500 mr-2"></i> Search Shortcuts
                    </h3>
                    <div class="flex flex-wrap gap-2 text-sm">
                        <button onclick="openSearchPreset('risk')" class="px-3 py-1.5 rounded border hover:bg-gray-50">At-risk students</button>
                        <button onclick="openSearchPreset('assignment')" class="px-3 py-1.5 rounded border hover:bg-gray-50">Overdue assignments</button>
                        <button onclick="openSearchPreset('dbms')" class="px-3 py-1.5 rounded border hover:bg-gray-50">DBMS resources</button>
                    </div>
                </div>

                <!-- Faculty Assignments Mini Panel -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-indigo-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-tasks text-indigo-500 mr-2"></i> Assignments
                    </h3>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="p-4 bg-indigo-50 rounded-lg border border-indigo-200">
                            <h4 class="font-semibold text-indigo-800 mb-3">Create Assignment</h4>
                            <div class="space-y-2">
                                <input id="assignmentTitle" class="form-input w-full" placeholder="Title (e.g. DBMS Assignment 1)" />
                                <textarea id="assignmentDesc" class="form-input w-full" placeholder="Description" rows="3"></textarea>
                                <input id="assignmentDueDate" type="date" class="form-input w-full" />
                                <button onclick="createAssignment()" class="btn-primary w-full">
                                    <i class="fas fa-plus mr-2"></i>Create
                                </button>
                            </div>
                        </div>
                        <div class="p-4 bg-slate-50 rounded-lg border border-slate-200">
                            <div class="flex items-center justify-between mb-3">
                                <h4 class="font-semibold text-slate-800">Assignments & Submissions</h4>
                                <button onclick="loadAssignmentsPanel()" class="text-sm px-2 py-1 border rounded hover:bg-white">Refresh</button>
                            </div>
                            <div id="facultyAssignmentsMiniList" class="space-y-2 text-sm text-gray-700">
                                <p>Loading assignments...</p>
                            </div>
                            <div id="facultySubmissionDetails" class="mt-3 hidden border-t pt-3">
                                <p class="font-semibold text-sm mb-2" id="facultySubmissionTitle">Submission Status</p>
                                <div class="flex flex-wrap gap-2 mb-2" id="facultySubmissionFilters">
                                    <button type="button" class="submission-filter-chip px-2 py-1 text-xs rounded-full border bg-slate-900 text-white" data-status="all">All</button>
                                    <button type="button" class="submission-filter-chip px-2 py-1 text-xs rounded-full border bg-white text-slate-700" data-status="pending">Pending</button>
                                    <button type="button" class="submission-filter-chip px-2 py-1 text-xs rounded-full border bg-white text-slate-700" data-status="submitted">Submitted</button>
                                    <button type="button" class="submission-filter-chip px-2 py-1 text-xs rounded-full border bg-white text-slate-700" data-status="completed">Completed</button>
                                </div>
                                <div id="facultySubmissionList" class="max-h-56 overflow-y-auto divide-y"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-emerald-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-calendar-alt text-emerald-500 mr-2"></i> Smart Class Planner
                    </h3>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="p-4 bg-emerald-50 rounded border border-emerald-200 space-y-2">
                            <input id="classPlanName" class="form-input w-full" placeholder="Class (e.g. CSE-A)" />
                            <input id="classPlanSubject" class="form-input w-full" placeholder="Subject (e.g. DBMS)" />
                            <input id="classPlanTime" class="form-input w-full" placeholder="Schedule time (e.g. Mon 10:00 AM)" />
                            <input id="classPlanSyllabus" class="form-input w-full" placeholder="Syllabus URL (optional)" />
                            <button onclick="createClassPlan()" class="btn-primary w-full">Create Class Plan</button>
                        </div>
                        <div class="p-4 bg-slate-50 rounded border border-slate-200">
                            <div class="flex items-center justify-between mb-2">
                                <p class="font-semibold text-sm">Planned Classes</p>
                                <button onclick="loadClassPlans()" class="text-xs px-2 py-1 border rounded hover:bg-white">Refresh</button>
                            </div>
                            <div id="classPlansList" class="space-y-2 text-sm text-gray-700">
                                <p>Loading class plans...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-violet-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-handshake text-violet-500 mr-2"></i> Parent Meeting Requests
                    </h3>
                    <div id="facultyMeetingsList" class="space-y-2 text-sm text-gray-700">
                        <p>Loading meeting requests...</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-cyan-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-book-open text-cyan-500 mr-2"></i> Faculty Resource Center
                    </h3>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="p-4 bg-cyan-50 rounded border border-cyan-200 space-y-2">
                            <input id="resourceSubject" class="form-input w-full" placeholder="Subject (e.g. DBMS)" />
                            <input id="resourceTitle" class="form-input w-full" placeholder="Title" />
                            <select id="resourceType" class="form-input w-full">
                                <option value="note">Note</option>
                                <option value="video">Video</option>
                                <option value="assignment">Assignment</option>
                                <option value="link">Link</option>
                            </select>
                            <input id="resourceUrl" class="form-input w-full" placeholder="URL / file link" />
                            <textarea id="resourceDesc" class="form-input w-full" rows="2" placeholder="Description (optional)"></textarea>
                            <button onclick="createLearningResource()" class="btn-primary w-full">Add Resource</button>
                        </div>
                        <div class="p-4 bg-slate-50 rounded border border-slate-200">
                            <div class="flex items-center justify-between mb-2">
                                <p class="font-semibold text-sm">Latest Shared Resources</p>
                                <button onclick="loadLearningResourcesMini()" class="text-xs px-2 py-1 border rounded hover:bg-white">Refresh</button>
                            </div>
                            <div id="facultyResourceList" class="space-y-2 text-sm text-gray-700">
                                <p>Loading resources...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-fuchsia-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-file-csv text-fuchsia-500 mr-2"></i> Auto Evaluation System
                    </h3>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="p-4 bg-fuchsia-50 rounded border border-fuchsia-200">
                            <p class="text-sm text-fuchsia-800 mb-2">Upload marks CSV with columns: <code>student_id,marks</code></p>
                            <input id="autoEvalCsvFile" type="file" accept=".csv,text/csv" class="form-input w-full" />
                            <button onclick="runAutoEvaluation()" class="btn-primary mt-2 w-full">Run Auto Evaluation</button>
                        </div>
                        <div class="p-4 bg-slate-50 rounded border border-slate-200">
                            <p class="font-semibold text-sm mb-2">Evaluation Result</p>
                            <div id="autoEvalResult" class="text-sm text-gray-700">
                                <p>No evaluation run yet.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-amber-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-user-clock text-amber-500 mr-2"></i> Attendance Reasons (30 days)
                    </h3>
                    <div id="attendanceReasonSummary" class="text-sm text-gray-700 space-y-1">
                        <p>Loading reason patterns...</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-red-500">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xl font-semibold flex items-center">
                            <i class="fas fa-bell text-red-500 mr-2"></i> Faculty Alert Center
                        </h3>
                        <button onclick="loadFacultyAlertCenter()" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Refresh</button>
                    </div>
                    <div id="facultyAlertCenterList" class="space-y-2 text-sm text-gray-700">
                        <p>Loading alerts...</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-sky-500">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xl font-semibold flex items-center">
                            <i class="fas fa-chart-area text-sky-500 mr-2"></i> Teaching Effectiveness Analytics
                        </h3>
                        <button onclick="loadTeachingEffectiveness()" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Refresh</button>
                    </div>
                    <div id="teachingEffectivenessKpis" class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm mb-3">
                        <div class="p-2 rounded border bg-gray-50">Loading...</div>
                    </div>
                    <div id="teachingEffectivenessSuggestions" class="space-y-1 text-sm text-gray-700"></div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-cyan-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-xl font-semibold flex items-center">
                                <i class="fas fa-file-alt text-cyan-500 mr-2"></i> Academic Audit
                            </h3>
                            <p class="text-sm text-gray-500 mt-1">View student audit report and add faculty remarks.</p>
                        </div>
                        <button onclick="openAuditDrawer()" class="btn-primary">
                            <i class="fas fa-sliders-h mr-2"></i>Open Audit Drawer
                        </button>
                    </div>
                </div>

                <!-- Research Portal Section -->
                <section id="research" class="content-section hidden fade-in">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-3xl font-bold text-gray-800">Research & Publications</h2>
                        <button onclick="openModal('addResearchModal')" class="btn-primary">
                            <i class="fas fa-plus mr-2"></i> Add Publication
                        </button>
                    </div>
                    <div id="researchList" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Dynamic -->
                    </div>
                </section>

                <!-- Appointments Section -->
                <section id="appointments" class="content-section hidden fade-in">
                    <h2 class="text-3xl font-bold mb-6 text-gray-800">Parent-Faculty Appointments</h2>
                    <div class="bg-white rounded-lg shadow-md overflow-hidden">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-gray-50 text-gray-700">
                                <tr>
                                    <th class="p-4 border-b font-bold uppercase text-xs">Parent</th>
                                    <th class="p-4 border-b font-bold uppercase text-xs">Student</th>
                                    <th class="p-4 border-b font-bold uppercase text-xs">Purpose</th>
                                    <th class="p-4 border-b font-bold uppercase text-xs">Date</th>
                                    <th class="p-4 border-b font-bold uppercase text-xs">Status</th>
                                    <th class="p-4 border-b font-bold uppercase text-xs">Action</th>
                                </tr>
                            </thead>
                            <tbody id="appointmentsList" class="text-sm text-gray-600">
                                <!-- Dynamic -->
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Recent Activities -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                    <h3 class="text-xl font-semibold mb-4">Recent Activities</h3>
                    <div class="space-y-4">
                        <div class="flex items-center space-x-4 p-3 hover:bg-gray-50 rounded-lg transition">
                            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-plus text-blue-600"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-medium">New student registered</p>
                                <p class="text-sm text-gray-500">John Doe - Computer Science Engineering</p>
                            </div>
                            <span class="text-sm text-gray-400">2 min ago</span>
                        </div>
                        
                        <div class="flex items-center space-x-4 p-3 hover:bg-gray-50 rounded-lg transition">
                            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-file-alt text-green-600"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-medium">Course updated</p>
                                <p class="text-sm text-gray-500">Machine Learning Fundamentals - AI & ML Dept</p>
                            </div>
                            <span class="text-sm text-gray-400">1 hour ago</span>
                        </div>
                        
                        <div class="flex items-center space-x-4 p-3 hover:bg-gray-50 rounded-lg transition">
                            <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-tie text-purple-600"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-medium">New faculty joined</p>
                                <p class="text-sm text-gray-500">Dr. Sarah Johnson - Pharmacy Department</p>
                            </div>
                            <span class="text-sm text-gray-400">3 hours ago</span>
                        </div>
                    </div>
                </div>

                <!-- Department Distribution -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold mb-4">Department Distribution</h3>
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">425</p>
                            <p class="text-sm text-gray-600">AI & ML</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">380</p>
                            <p class="text-sm text-gray-600">Computer Science</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">320</p>
                            <p class="text-sm text-gray-600">Information Science</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">290</p>
                            <p class="text-sm text-gray-600">Civil Engineering</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">260</p>
                            <p class="text-sm text-gray-600">Electrical & Electronics</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Attendance Section -->
            <section id="attendance" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Mark Attendance</h2>
                    <div class="flex gap-2">
                        <input type="date" id="attendanceDate" class="form-input" value="${new Date().toISOString().split('T')[0]}">
                        <button class="btn-primary" onclick="loadAttendanceMarking()">
                            <i class="fas fa-sync mr-2"></i>Refresh List
                        </button>
                    </div>
                </div>
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceMarkingList" class="divide-y divide-gray-200">
                            <!-- Dynamic attendance rows -->
                        </tbody>
                    </table>
                </div>
