                    <!-- Engineering Departments -->
                    <div class="department-card card-shadow" onclick="showDepartmentDetails('ai-ml')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-robot text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">425 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Artificial Intelligence & Machine Learning Engineering</h3>
                        <p class="text-sm text-gray-600 mb-3">Advanced AI and ML technologies, neural networks, deep learning</p>
                        <div class="flex items-center text-sm text-gray-500">
                            <i class="fas fa-book mr-2"></i>
                            <span>15 Courses</span>
                        </div>
                    </div>

                    <div class="department-card card-shadow" onclick="showDepartmentDetails('cse')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-laptop-code text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">380 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Computer Science Engineering</h3>
                        <p class="text-sm text-gray-600 mb-3">Programming, algorithms, software development, computer systems</p>
                        <div class="flex items-center text-sm text-gray-500">
                            <i class="fas fa-book mr-2"></i>
                            <span>18 Courses</span>
                        </div>
                    </div>

                    <div class="department-card card-shadow" onclick="showDepartmentDetails('ise')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-database text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">320 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Information Science Engineering</h3>
                        <p class="text-sm text-gray-600 mb-3">Data management, information systems, web technologies</p>
                        <div class="flex items-center text-sm text-gray-500">
                            <i class="fas fa-book mr-2"></i>
                            <span>16 Courses</span>
                        </div>
                    </div>

                    <div class="department-card card-shadow" onclick="showDepartmentDetails('civil')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-building text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">290 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Civil Engineering</h3>
                        <p class="text-sm text-gray-600 mb-3">Construction, infrastructure, structural design, urban planning</p>
                        <div class="flex items-center text-sm text-gray-500">
                            <i class="fas fa-book mr-2"></i>
                            <span>14 Courses</span>
                        </div>
                    </div>

                    <div class="department-card card-shadow" onclick="showDepartmentDetails('eee')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-bolt text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">260 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Electrical & Electronics Engineering</h3>
                        <p class="text-sm text-gray-600 mb-3">Power systems, electronics, control systems, telecommunications</p>
