                console.error(err);
            }
        }

        function masterAuthHeaders() {
            return { 'Authorization': `Bearer ${localStorage.getItem('token')}` };
        }

        function masterAuthHeadersJson() {
            return { 'Authorization': `Bearer ${localStorage.getItem('token')}`, 'Content-Type': 'application/json' };
        }

        async function loadMaterialsFilterSubjects() {
            const filter = document.getElementById('materialFilterSubject');
            if (!filter) return;
            try {
                const res = await fetch(`${API_BASE}/master/subjects`, { headers: masterAuthHeaders() });
                const data = await res.json();
                const items = data.items || [];
                filter.innerHTML = '<option value="">All subjects</option>' +
                    items.map(s => `<option value="${s.id}">${s.name}${s.department_name ? ' (' + s.department_name + ')' : ''}</option>`).join('');
            } catch (e) { /* no-op */ }
        }

        async function loadFacultyAcademicCalendar() {
            const el = document.getElementById('facultyCalendarList');
            if (!el) return;
            try {
                const res = await fetch(`${API_BASE}/academic/calendar?days=30`, { headers: masterAuthHeaders() });
                const data = await res.json();
                const items = data.items || [];
                el.innerHTML = items.length ? items.slice(0, 12).map(ev => `
                    <div class="p-2 rounded border bg-gray-50 flex justify-between gap-2">
                        <span><strong>${ev.title}</strong> <span class="text-xs text-gray-400">(${ev.event_type})</span></span>
                        <span class="text-xs text-gray-500 whitespace-nowrap">${ev.starts_at || ''}</span>
                    </div>
                `).join('') : '<p class="text-gray-500">No events in the next 30 days.</p>';
            } catch (e) {
                el.innerHTML = '<p class="text-red-500">Failed to load calendar</p>';
            }
        }

        async function createFacultyCalendarEvent() {
            const title = document.getElementById('calEventTitle')?.value?.trim();
            const event_type = document.getElementById('calEventType')?.value || 'other';
            const starts_at = document.getElementById('calEventStarts')?.value;
            if (!title || !starts_at) {
                showToast('Title and date/time required', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/academic/calendar`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify({ title, event_type, starts_at: starts_at.replace('T', ' ') })
                });
                if (res.ok) {
                    showToast('Event added', 'success');
                    document.getElementById('calEventTitle').value = '';
                    loadFacultyAcademicCalendar();
                } else {
                    const d = await res.json();
                    showToast(d.message || 'Failed', 'error');
                }
            } catch (e) {
                showToast('Failed to add event', 'error');
            }
        }

        async function loadMaterials() {
            const list = document.getElementById('notesList');
            if (!list) return;
            const subjectId = document.getElementById('materialFilterSubject')?.value || document.getElementById('materialSubject')?.value || '';
            const qs = subjectId ? `?subject_id=${encodeURIComponent(subjectId)}&limit=80` : '?limit=80';
            try {
                const res = await fetch(`${API_BASE}/master/materials${qs}`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                if (!res.ok) {
                    list.innerHTML = `<p class="text-gray-500 col-span-full">${data.message || 'Failed to load materials'}</p>`;
                    return;
                }
                list.innerHTML = (data.items || []).map(m => `
                    <div class="student-item p-4 bg-white rounded-lg shadow-sm border mb-3 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold">${m.title}</h4>
                            <p class="text-xs text-gray-500">${m.subject_name || 'Subject'} • ${(m.material_type || '').toUpperCase()}</p>
                        </div>
                        <a href="${m.url}" target="_blank" class="text-blue-600 hover:underline"><i class="fas fa-external-link-alt"></i></a>
                    </div>
                `).join('');
            } catch (err) {
                console.error(err);
            }
        }

        async function uploadMaterial(event) {
            event.preventDefault();
            const subject_id = document.getElementById('materialSubject').value;
            const title = document.getElementById('materialTitle').value;
            const material_type = document.getElementById('materialType').value;
            const url = document.getElementById('materialUrl').value;
            const description = document.getElementById('materialDesc').value;

            try {
                const res = await fetch(`${API_BASE}/master/materials`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify({ subject_id, title, material_type, url, description })
                });
                if (res.ok) {
                    showToast('Material uploaded successfully!', 'success');
                    closeModal('uploadMaterialModal');
                    loadMaterials();
                } else {
                    showToast('Upload failed', 'error');
                }
            } catch (err) {
                showToast('Upload failed', 'error');
            }
        }

