            <!-- Students Section -->
            <section id="students" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">My Students</h2>
                    <div class="flex gap-2">
                        <input type="text" id="facultySearchStudent" class="form-input" placeholder="Search students..." oninput="loadFacultyStudents()">
                    </div>
                </div>
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Department</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Attendance</th>
                            </tr>
                        </thead>
                        <tbody id="facultyStudentsList" class="divide-y divide-gray-200">
                            <!-- Dynamic student rows -->
                        </tbody>
                    </table>
                </div>

                <div class="mt-8 bg-white rounded-lg shadow-md p-6 border-l-4 border-indigo-500">
                    <h3 class="text-lg font-semibold mb-4"><i class="fas fa-graduation-cap text-indigo-500 mr-2"></i>Record subject grade (GPA)</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-3 items-end">
                        <div>
                            <label class="text-xs text-gray-500">Student ID</label>
                            <input id="gradeStudentId" type="number" class="form-input w-full" placeholder="e.g. 1" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="text-xs text-gray-500">Subject</label>
                            <select id="gradeSubjectId" class="form-input w-full"></select>
                        </div>
                        <div>
                            <label class="text-xs text-gray-500">Grade points (0-10)</label>
                            <input id="gradePoints" type="number" step="0.1" min="0" max="10" class="form-input w-full" />
                        </div>
                        <div>
                            <label class="text-xs text-gray-500">Status</label>
                            <select id="gradeStatus" class="form-input w-full">
                                <option value="passed">Passed</option>
                                <option value="failed">Failed</option>
                                <option value="backlog">Backlog</option>
                                <option value="pending">Pending</option>
                            </select>
                        </div>
                        <button onclick="saveFacultyGrade()" class="btn-primary w-full py-2.5">Save grade</button>
                    </div>
                    <p id="gradeSaveStatus" class="text-xs text-gray-500 mt-2"></p>
                    <div id="gradePreviewSummary" class="mt-3 text-sm text-gray-700 hidden"></div>
                </div>
            </section>

            <!-- Study Materials Section (Repurposed from Courses) -->
            <section id="notes" class="content-section hidden fade-in">
                <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Study Materials</h2>
                    <div class="flex flex-wrap items-center gap-2">
                        <select id="materialFilterSubject" class="form-input text-sm" onchange="loadMaterials()">
                            <option value="">All subjects</option>
                        </select>
                        <button class="btn-primary" onclick="openUploadModal()">
                            <i class="fas fa-upload mr-2"></i>Upload Material
                        </button>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-4 mb-6 border-l-4 border-indigo-500">
                    <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
                        <h3 class="font-semibold text-gray-800"><i class="fas fa-calendar-alt text-indigo-500 mr-2"></i>Academic Calendar (30 days)</h3>
                        <button onclick="loadFacultyAcademicCalendar()" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Refresh</button>
                    </div>
                    <div id="facultyCalendarList" class="space-y-2 text-sm max-h-48 overflow-y-auto">
                        <p class="text-gray-500">Loading...</p>
                    </div>
                    <div class="mt-3 pt-3 border-t grid grid-cols-1 md:grid-cols-4 gap-2">
                        <input id="calEventTitle" class="form-input text-sm" placeholder="Event title" />
                        <select id="calEventType" class="form-input text-sm">
                            <option value="class">Class</option>
                            <option value="exam">Exam</option>
                            <option value="holiday">Holiday</option>
                            <option value="other">Other</option>
                        </select>
                        <input id="calEventStarts" type="datetime-local" class="form-input text-sm" />
                        <button onclick="createFacultyCalendarEvent()" class="btn-primary text-sm py-2">Add event</button>
                    </div>
                </div>

                <div id="notesList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Dynamic materials here -->
                </div>
            </section>

