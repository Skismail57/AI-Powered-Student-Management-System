                suggEl.innerHTML = `
                    <div class="p-2 border rounded bg-sky-50">
                        <p class="font-semibold mb-1">AI Teaching Suggestions</p>
                        ${suggestions.map(s => `<p>• ${s}</p>`).join('')}
                    </div>
                    <div class="p-2 border rounded bg-white mt-2">
                        <p class="font-semibold mb-1">Weak Topics Snapshot</p>
                        ${weak.length ? weak.slice(0, 5).map(w => `<p>• ${w.topic}: avg ${Number(w.avg_score || 0).toFixed(1)} (${w.attempts} attempts)</p>`).join('') : '<p>No weak topics currently.</p>'}
                    </div>
                `;
            } catch (e) {
                suggEl.innerHTML = '<p>Failed to load analytics.</p>';
            }
        }

        async function loadDecisionSupportPanel() {
            const kpisEl = document.getElementById('decisionSupportKpis');
            const listEl = document.getElementById('decisionSupportList');
            const total7El = document.getElementById('decisionActionsTotal7d');
            const trend7El = document.getElementById('decisionActionsTrend7d');
            const recentEl = document.getElementById('decisionActionsRecent');
            if (!kpisEl || !listEl) return;
            try {
                const [res, historyRes] = await Promise.all([
                    fetch(`${API_BASE}/faculty/decision-support`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                    }),
                    fetch(`${API_BASE}/faculty/decision-support/actions/history`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                    })
                ]);
                const data = await res.json();
                const history = await historyRes.json();
                if (!res.ok) {
                    listEl.innerHTML = `<p>${data.message || 'Failed to load recommendations.'}</p>`;
                    return;
                }
                const k = data.kpis || {};
                kpisEl.innerHTML = `
                    <div class="p-2 rounded border bg-gray-50"><p class="text-gray-500">Low Attendance</p><p class="font-semibold">${k.low_attendance_count ?? 0}</p></div>
                    <div class="p-2 rounded border bg-gray-50"><p class="text-gray-500">Open Risk Alerts</p><p class="font-semibold">${k.open_risk_alerts ?? 0}</p></div>
                    <div class="p-2 rounded border bg-gray-50"><p class="text-gray-500">Overdue Submissions</p><p class="font-semibold">${k.overdue_submission_count ?? 0}</p></div>
                    <div class="p-2 rounded border bg-gray-50"><p class="text-gray-500">Attendance Trend</p><p class="font-semibold ${Number(k.attendance_trend_delta || 0) < 0 ? 'text-red-600' : 'text-green-600'}">${k.attendance_trend_delta ?? 0}</p></div>
                `;

                const items = data.recommendations || [];
                if (!items.length) {
                    listEl.innerHTML = '<p>No recommendations right now.</p>';
                    return;
                }
                listEl.innerHTML = items.map(r => `
                    <div class="p-3 rounded border ${r.priority === 'high' ? 'bg-red-50 border-red-200' : r.priority === 'medium' ? 'bg-amber-50 border-amber-200' : 'bg-blue-50 border-blue-200'}">
                        <div class="flex items-center justify-between">
                            <p class="font-semibold">${r.title || 'Recommendation'}</p>
                            <span class="text-xs px-2 py-1 rounded-full ${r.priority === 'high' ? 'bg-red-100 text-red-700' : r.priority === 'medium' ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700'}">${String(r.priority || 'info').toUpperCase()}</span>
                        </div>
                        <p class="text-xs text-gray-600 mt-1">${r.reason || ''}</p>
                        <p class="text-sm mt-2">${r.action || ''}</p>
                        ${r.completed_at ? `<p class="text-xs text-emerald-700 mt-2">Marked done at ${new Date(r.completed_at).toLocaleString()}</p>` : ''}
                        <div class="mt-2 flex flex-wrap gap-2">
                            ${buildDecisionActionButtons(r)}
                            <button
                                class="px-2 py-1 text-xs rounded border ${r.completed_at ? 'bg-emerald-100 text-emerald-700 border-emerald-300' : 'bg-emerald-600 text-white border-emerald-700 hover:bg-emerald-700'}"
                                onclick="markDecisionActionDone('${String(r.key || '').replace(/'/g, "\\'")}', '${String(r.title || '').replace(/'/g, "\\'")}', '${String(r.action || '').replace(/'/g, "\\'")}')"
                                ${r.completed_at ? 'disabled' : ''}
                            >
                                ${r.completed_at ? 'Done' : 'Mark done'}
                            </button>
                        </div>
                    </div>
                `).join('');

                if (historyRes.ok) {
                    const daily = history.daily || [];
                    const maxCount = Math.max(1, ...daily.map(d => Number(d.count || 0)));
                    if (total7El) total7El.textContent = `${history.total_last_7_days || 0} completed`;
                    if (trend7El) {
                        trend7El.innerHTML = daily.map((d, idx) => {
                            const c = Number(d.count || 0);
                            const h = Math.max(4, Math.round((c / maxCount) * 36));
                            const prev = idx > 0 ? Number(daily[idx - 1].count || 0) : c;
                            const toneClass = c > prev
                                ? 'bg-emerald-500'
                                : c < prev
                                    ? 'bg-red-500'
                                    : 'bg-amber-500';
                            const momentum = c > prev ? 'increasing' : c < prev ? 'declining' : 'flat';
                            return `<div title="${d.day}: ${c} (${momentum})" class="w-3 rounded-t ${toneClass}" style="height:${h}px"></div>`;
                        }).join('');
                    }
                    if (recentEl) {
                        const recent = history.recent || [];
                        recentEl.innerHTML = recent.length
                            ? recent.slice(0, 5).map(r => `<p>• ${r.title} <span class="text-gray-400">(${new Date(r.completed_at).toLocaleString()})</span></p>`).join('')
                            : '<p>No actions marked done in the last 7 days.</p>';
                    }
                } else {
                    if (recentEl) recentEl.innerHTML = '<p>Unable to load action history.</p>';
                }
            } catch (e) {
                listEl.innerHTML = '<p>Failed to load recommendations.</p>';
                if (recentEl) recentEl.innerHTML = '<p>Unable to load action history.</p>';
            }
        }

        function buildDecisionActionButtons(rec) {
            const t = String(rec?.title || '').toLowerCase();
            const buttons = [];
            if (t.includes('attendance')) {
                buttons.push(`<button class="px-2 py-1 text-xs rounded border bg-white hover:bg-gray-50" onclick="actionOpenAtRiskStudents()">Open at-risk students</button>`);
                buttons.push(`<button class="px-2 py-1 text-xs rounded border bg-white hover:bg-gray-50" onclick="actionOpenAttendancePatterns()">Open attendance patterns</button>`);
            }
            if (t.includes('assignment') || t.includes('overdue')) {
                buttons.push(`<button class="px-2 py-1 text-xs rounded border bg-white hover:bg-gray-50" onclick="actionOpenOverdueSubmissions()">Open overdue submissions</button>`);
            }
            if (t.includes('risk')) {
                buttons.push(`<button class="px-2 py-1 text-xs rounded border bg-white hover:bg-gray-50" onclick="actionOpenInterventions()">Open interventions</button>`);
            }
            if (!buttons.length) {
                buttons.push(`<button class="px-2 py-1 text-xs rounded border bg-white hover:bg-gray-50" onclick="loadDecisionSupportPanel()">Refresh recommendation</button>`);
            }
            return buttons.join('');
        }

        function actionOpenAtRiskStudents() {
            showSection('students');
            const searchEl = document.getElementById('searchStudent');
            if (searchEl) searchEl.value = '';
            loadStudents(1);
            showToast('Opened students list. Focus on low-attendance/risk rows.', 'success');
        }

        function actionOpenAttendancePatterns() {
            showSection('dashboard');
            loadAttendanceReasonSummary();
            const panel = document.getElementById('attendanceReasonSummary');
            if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
            showToast('Opened attendance pattern summary.', 'success');
        }

        async function actionOpenOverdueSubmissions() {
            showSection('dashboard');
            await loadAssignmentsPanel();
            try {
                const listRes = await fetch(`${API_BASE}/assignments`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const listData = await listRes.json();
                const items = listData.items || [];
                const overdue = items.find(a => a.due_date && new Date(a.due_date) < new Date());
                if (!overdue) {
                    showToast('No overdue assignments found.', 'success');
                    return;
                }
                await viewAssignmentSubmissions(overdue.id, overdue.title || `Assignment ${overdue.id}`);
                activeSubmissionFilter = 'pending';
                renderSubmissionFilters();
                renderSubmissionList();
                const wrap = document.getElementById('facultySubmissionDetails');
                if (wrap) wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
                showToast('Opened overdue submission triage.', 'success');
            } catch (e) {
                showToast('Failed to open overdue submissions.', 'error');
            }
        }

        function actionOpenInterventions() {
            openAuditDrawer();
            const content = document.getElementById('auditInterventionsContent');
            if (content) content.innerHTML = '<p>Enter student ID and click "Open interventions for this student".</p>';
            showToast('Audit drawer opened. Use student ID to jump into interventions.', 'success');
        }

        async function markDecisionActionDone(actionKey, title, details) {
            if (!actionKey) {
                showToast('Missing recommendation key', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/faculty/decision-support/actions`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        action_key: actionKey,
                        title: title || 'Decision action',
                        details: details || ''
                    })
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.message || 'Failed to mark action done', 'error');
                    return;
                }
                showToast('Decision action logged', 'success');
                loadDecisionSupportPanel();
            } catch (e) {
                showToast('Failed to mark action done', 'error');
            }
        }

        function openAuditDrawer() {
            const drawer = document.getElementById('auditDrawer');
            if (drawer) drawer.classList.remove('translate-x-full');
        }

        function closeAuditDrawer() {
            const drawer = document.getElementById('auditDrawer');
            if (drawer) drawer.classList.add('translate-x-full');
        }

        async function loadAcademicAuditReport() {
            const studentId = Number(document.getElementById('auditStudentId')?.value || 0);
            const content = document.getElementById('auditReportContent');
            if (!studentId) {
                showToast('Student ID is required', 'error');
                return;
            }
            auditStudentIdCurrent = studentId;
            if (content) content.innerHTML = '<p>Loading audit report...</p>';
            try {
                const res = await fetch(`${API_BASE}/students/${studentId}/academic-audit`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    if (content) content.innerHTML = `<p>${data.message || 'Failed to load audit report.'}</p>`;
                    return;
                }
                const trend = data.performance_trend || {};
                const risk = data.risk_level || {};
                const remarks = data.faculty_remarks || [];
                if (content) {
                    content.innerHTML = `
                        <div class="p-3 rounded border bg-slate-50">
                            <p><span class="font-semibold">Student:</span> ${data.student?.name || '-'} (#${data.student?.id || '-'})</p>
                            <p><span class="font-semibold">Attendance:</span> ${data.attendance_summary?.attendance_pct ?? '-'}%</p>
                            <p><span class="font-semibold">Predicted Trend:</span> ${trend.previous_week_predicted_avg ?? 0} -> ${trend.current_week_predicted_avg ?? 0} (delta ${trend.delta ?? 0})</p>
                            <p><span class="font-semibold">Risk:</span> ${risk.level || '-'} (${risk.score ?? '-'})</p>
                        </div>
                        <div>
                            <p class="font-semibold mb-1">Recent Remarks</p>
                            ${remarks.length ? remarks.map(r => `<div class="p-2 border rounded mb-1"><p>${r.remark}</p><p class="text-xs text-gray-500 mt-1">${r.created_at || ''}</p></div>`).join('') : '<p class="text-gray-500">No remarks yet.</p>'}
                        </div>
                    `;
                }
            } catch (e) {
                if (content) content.innerHTML = '<p>Failed to load audit report.</p>';
            }
        }

        async function submitAcademicRemark() {
            const remark = (document.getElementById('auditRemark')?.value || '').trim();
            if (!auditStudentIdCurrent) {
                showToast('Load an audit report first', 'error');
                return;
            }
            if (!remark) {
                showToast('Remark cannot be empty', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/students/${auditStudentIdCurrent}/remarks`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ remark })
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.message || 'Failed to save remark', 'error');
                    return;
                }
                document.getElementById('auditRemark').value = '';
                showToast('Remark saved', 'success');
                loadAcademicAuditReport();
            } catch (e) {
                showToast('Failed to save remark', 'error');
            }
        }

        async function openStudentInterventions() {
            const studentId = auditStudentIdCurrent || Number(document.getElementById('auditStudentId')?.value || 0);
            const status = document.getElementById('auditInterventionStatus')?.value || 'open';
            const content = document.getElementById('auditInterventionsContent');
            if (!studentId) {
                showToast('Load or enter a student ID first', 'error');
                return;
            }
            if (content) content.innerHTML = '<p>Loading interventions...</p>';
            try {
                const res = await fetch(`${API_BASE}/interventions?status=${encodeURIComponent(status)}&limit=200`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    if (content) content.innerHTML = `<p>${data.message || 'Failed to load interventions.'}</p>`;
                    return;
                }
                const items = (data.items || []).filter(i => Number(i.student_id) === Number(studentId));
                if (!content) return;
                if (!items.length) {
                    content.innerHTML = `<p class="text-gray-500">No ${status === 'all' ? '' : status.replace('_', ' ')} interventions for this student.</p>`;
                    return;
                }
                content.innerHTML = items.map(i => `
                    <div class="p-2 border rounded mb-2 bg-slate-50">
                        <p><span class="font-semibold">Risk:</span> ${i.risk_level || '-'}</p>
                        <p><span class="font-semibold">Status:</span> ${i.status || '-'}</p>
                        <p><span class="font-semibold">Action:</span> ${i.action_plan || '-'}</p>
                        <p class="text-xs text-gray-500 mt-1">${i.created_at || ''}</p>
                    </div>
                `).join('');
            } catch (e) {
                if (content) content.innerHTML = '<p>Failed to load interventions.</p>';
            }
        }

        function renderSubmissionFilters() {
            const chips = document.querySelectorAll('.submission-filter-chip');
            chips.forEach(chip => {
                const status = chip.dataset.status;
                if (status === activeSubmissionFilter) {
                    chip.className = 'submission-filter-chip px-2 py-1 text-xs rounded-full border bg-slate-900 text-white';
                } else {
                    chip.className = 'submission-filter-chip px-2 py-1 text-xs rounded-full border bg-white text-slate-700 hover:bg-slate-50';
                }

                if (!chip.dataset.bound) {
                    chip.dataset.bound = '1';
                    chip.addEventListener('click', () => {
                        activeSubmissionFilter = chip.dataset.status || 'all';
                        renderSubmissionFilters();
                        renderSubmissionList();
                    });
                }
            });
        }

        function renderSubmissionList() {
            const listEl = document.getElementById('facultySubmissionList');
            if (!listEl) return;
            const filtered = submissionItemsCache.filter(s =>
                activeSubmissionFilter === 'all' ? true : String(s.status || 'pending') === activeSubmissionFilter
            );
            if (!filtered.length) {
                listEl.innerHTML = '<div class="py-3 text-sm text-gray-500">No students in this status.</div>';
                return;
            }
            listEl.innerHTML = filtered.map(s => `
                <div class="py-2 border-b last:border-b-0">
                    <div class="flex items-center justify-between text-sm">
                        <span>${s.student_name}</span>
                        <span class="px-2 py-1 rounded-full text-xs font-semibold ${
                            s.status === 'completed' ? 'bg-green-100 text-green-700' :
                            s.status === 'submitted' ? 'bg-blue-100 text-blue-700' :
                            'bg-yellow-100 text-yellow-700'
                        }">${String(s.status || 'pending').toUpperCase()}</span>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">File: ${s.file_name || 'No upload'} • Grade: ${s.grade_score ?? '-'}</p>
                    <div class="mt-2 flex items-center gap-2">
                        <input id="gradeScore-${s.student_id}" type="number" min="0" max="100" step="0.1" class="form-input w-24 text-xs" placeholder="Score" value="${s.grade_score ?? ''}" />
                        <input id="gradeFeedback-${s.student_id}" type="text" class="form-input flex-1 text-xs" placeholder="Feedback" value="${(s.grade_feedback || '').replace(/"/g, '&quot;')}" />
                        <button onclick="gradeAssignmentSubmission(${s.student_id})" class="px-2 py-1 text-xs rounded border bg-emerald-600 text-white hover:bg-emerald-700">Save Grade</button>
                    </div>
                </div>
            `).join('');
        }

        async function gradeAssignmentSubmission(studentId) {
            if (!selectedAssignmentId) {
                showToast('Open an assignment first', 'error');
                return;
            }
            const score = Number(document.getElementById(`gradeScore-${studentId}`)?.value || NaN);
            const feedback = (document.getElementById(`gradeFeedback-${studentId}`)?.value || '').trim();
            if (Number.isNaN(score)) {
                showToast('Score is required', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/assignments/${selectedAssignmentId}/grade`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ student_id: studentId, grade_score: score, grade_feedback: feedback })
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.message || 'Failed to save grade', 'error');
                    return;
                }
                showToast('Grade saved', 'success');
                viewAssignmentSubmissions(selectedAssignmentId, (document.getElementById('facultySubmissionTitle')?.textContent || 'Submission Status').replace('Submission Status: ', ''));
            } catch (e) {
                showToast('Failed to save grade', 'error');
            }
        }

        let studentsPage = 1;
        let studentsPageSize = 25;
        let studentsTotal = 0;
        let studentsTotalPages = 1;
        let studentsSearchTimer = null;
        let auditStudentIdCurrent = null;

        function updateStudentsPaginationUI() {
            const showingEl = document.getElementById('studentsShowing');
            const pageInfoEl = document.getElementById('studentsPageInfo');
            const prevBtn = document.getElementById('studentsPrevBtn');
            const nextBtn = document.getElementById('studentsNextBtn');

            const start = studentsTotal === 0 ? 0 : (studentsPage - 1) * studentsPageSize + 1;
            const end = Math.min(studentsPage * studentsPageSize, studentsTotal);

            if (showingEl) showingEl.textContent = `Showing ${start}–${end} of ${studentsTotal}`;
            if (pageInfoEl) pageInfoEl.textContent = `Page ${studentsPage} of ${studentsTotalPages}`;
            if (prevBtn) prevBtn.disabled = studentsPage <= 1;
            if (nextBtn) nextBtn.disabled = studentsPage >= studentsTotalPages;
        }

        function getStudentsQueryParams() {
            const search = document.getElementById('searchStudent')?.value || '';
            const params = new URLSearchParams();
            params.set('paged', '1');
            params.set('page', String(studentsPage));
            params.set('page_size', String(studentsPageSize));
            if (search) params.set('search', search);
            return params;
        }

        // Load students (server-side pagination)
        async function loadStudents(page = 1) {
            try {
                studentsPage = Math.max(1, parseInt(page, 10) || 1);
                const response = await fetch(`${API_BASE}/students?${getStudentsQueryParams().toString()}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await response.json();
                const students = data.items || [];
                studentsTotal = data.total || 0;
                studentsTotalPages = data.total_pages || 1;
                
                const tbody = document.querySelector('#students tbody');
                if (tbody) {
                    tbody.innerHTML = students.map(student => `
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <img class="h-10 w-10 rounded-full" src="https://picsum.photos/seed/student${student.id}/50/50" alt="">
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-gray-900">${student.name}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">#${student.id}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">General</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">--</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">--</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${student.attendance >= 75 ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
                                    Active
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button onclick="editStudent(${student.id}, '${student.name}', ${student.attendance}, ${student.study_hours}, ${student.sleep_hours})" class="text-blue-600 hover:text-blue-900 mr-3">Edit</button>
                                <button onclick="deleteStudent(${student.id})" class="text-red-600 hover:text-red-900">Delete</button>
                            </td>
                        </tr>
                    `).join('');
                }

                const searchEl = document.getElementById('searchStudent');
                const pageSizeEl = document.getElementById('studentsPageSize');
                const prevBtn = document.getElementById('studentsPrevBtn');
                const nextBtn = document.getElementById('studentsNextBtn');

                if (searchEl && !searchEl.dataset.boundPaged) {
                    searchEl.dataset.boundPaged = '1';
                    searchEl.addEventListener('input', () => {
                        clearTimeout(studentsSearchTimer);
                        studentsSearchTimer = setTimeout(() => loadStudents(1), 250);
                    });
                }

                if (pageSizeEl && !pageSizeEl.dataset.boundPaged) {
                    pageSizeEl.dataset.boundPaged = '1';
                    pageSizeEl.addEventListener('change', () => {
                        studentsPageSize = parseInt(pageSizeEl.value, 10) || 25;
                        loadStudents(1);
                    });
                }

                if (prevBtn && !prevBtn.dataset.boundPaged) {
                    prevBtn.dataset.boundPaged = '1';
                    prevBtn.addEventListener('click', () => loadStudents(studentsPage - 1));
                }

                if (nextBtn && !nextBtn.dataset.boundPaged) {
                    nextBtn.dataset.boundPaged = '1';
                    nextBtn.addEventListener('click', () => loadStudents(studentsPage + 1));
                }

                updateStudentsPaginationUI();
            } catch (err) {
                console.error(err);
            }
        }

        async function downloadStudentsReport(format) {
            try {
                const search = document.getElementById('searchStudent')?.value || '';
                const params = new URLSearchParams();
                if (search) params.set('search', search);
                const endpoint = `${API_BASE}/reports/students.${format}?${params.toString()}`;

                const res = await fetch(endpoint, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Export failed!', 'error');
                    return;
                }

                const blob = await res.blob();
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `students_${new Date().toISOString().split('T')[0]}.${format}`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
                showToast('Report downloaded!', 'success');
            } catch (e) {
                showToast('Export failed!', 'error');
            }
        }

        // Add student
        async function addStudent(event) {
            event.preventDefault();
            const name = prompt('Enter student name:');
            if (!name) return;
            
            try {
                await fetch(`${API_BASE}/students`, {
                    method: 'POST',
                    headers: { 
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name, attendance: 0, study_hours: 0, sleep_hours: 0 })
                });
                loadStudents(1);
                showToast('Student added!', 'success');
            } catch (err) {
                showToast('Failed to add student!', 'error');
            }
            closeModal('addStudentModal');
        }

        // Edit student
        async function editStudent(id, name, attendance, study_hours, sleep_hours) {
            const newName = prompt('Enter new name:', name);
            const newAtt = prompt('Enter attendance %:', attendance);
            const newStudy = prompt('Enter study hours:', study_hours);
            const newSleep = prompt('Enter sleep hours:', sleep_hours);
            
            if (!newName) return;
            
            try {
                await fetch(`${API_BASE}/students/${id}`, {
                    method: 'PUT',
                    headers: { 
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ 
                        name: newName, 
                        attendance: parseFloat(newAtt), 
                        study_hours: parseFloat(newStudy), 
                        sleep_hours: parseFloat(newSleep) 
                    })
                });
                loadStudents(studentsPage);
                showToast('Student updated!', 'success');
            } catch (err) {
                showToast('Update failed!', 'error');
            }
        }

        // Delete student
        async function deleteStudent(id) {
            if (!confirm('Delete this student?')) return;
            
            try {
                await fetch(`${API_BASE}/students/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                loadStudents(studentsPage);
                showToast('Student deleted!', 'success');
            } catch (err) {
                showToast('Delete failed!', 'error');
            }
        }

        // Add course (placeholder)
        function addCourse(event) {
            event.preventDefault();
            alert('Course feature coming soon!');
            closeModal('addCourseModal');
        }

        // Add faculty (placeholder)
        function addFaculty(event) {
            event.preventDefault();
            alert('Faculty feature coming soon!');
            closeModal('addFacultyModal');
        }

        // Add department (placeholder)
        function addDepartment(event) {
            event.preventDefault();
            alert('Department feature coming soon!');
            closeModal('addDepartmentModal');
        }

        // Show department details
        function showDepartmentDetails(departmentId) {
            alert(`Showing details for department: ${departmentId}`);
        }

        // Show toast
        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.textContent = message;
            toast.style.position = 'fixed';
            toast.style.top = '20px';
            toast.style.right = '20px';
            toast.style.padding = '15px 25px';
            toast.style.borderRadius = '8px';
            toast.style.color = 'white';
            toast.style.fontWeight = '600';
            toast.style.zIndex = '1000';
            if (type === 'success') toast.style.background = '#4caf50';
            if (type === 'error') toast.style.background = '#f44336';
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>