    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <script>
        const API_BASE = 'http://localhost:5000';
        const socket = io(API_BASE);
        let submissionItemsCache = [];
        let activeSubmissionFilter = 'all';
        let selectedAssignmentId = null;
        let facultyThreadItems = [];
        
        document.addEventListener('DOMContentLoaded', () => {
            const user = JSON.parse(localStorage.getItem('user'));
            const token = localStorage.getItem('token');
            
            if (!token || user.role !== 'faculty') {
                window.location.href = 'login.html';
                return;
            }

            document.getElementById('facultyName').textContent = user.name;

            document.getElementById('logoutBtn').addEventListener('click', () => {
                localStorage.removeItem('token');
                localStorage.removeItem('user');
                window.location.href = 'login.html';
            });

            // Load dashboard data
            loadDashboard();
            loadAssignmentsPanel();
            loadClassPlans();
            loadFacultyMeetings();
            loadLearningResourcesMini();
            loadAttendanceReasonSummary();
            loadDecisionSupportPanel();
            loadFacultyAlertCenter();
            loadTeachingEffectiveness();
            loadNotifications();
            loadStudents(1);
            loadFacultyRecentContacts();
            
            socket.on('dashboard_update', loadDashboard);
            socket.on('notification_push', loadNotifications);
            socket.on('message_push', () => {
                const peer_role = (document.getElementById('quickMsgRole')?.value || '').trim();
                const peer_id = Number(document.getElementById('quickMsgRecipientId')?.value || 0);
                if (peer_role && peer_id > 0) loadQuickMessageThread();
            });
        });

        // Toggle sidebar on mobile
        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            sidebar.classList.toggle('active');
        }

        function toggleNotificationsPanel() {
            const panel = document.getElementById('notifPanel');
            if (!panel) return;
            panel.classList.toggle('hidden');
            if (!panel.classList.contains('hidden')) loadNotifications();
        }

        async function loadNotifications() {
            const listEl = document.getElementById('notifList');
            const badgeEl = document.getElementById('notifBadge');
            if (!listEl || !badgeEl) return;
            try {
                const res = await fetch(`${API_BASE}/notifications/me?limit=20`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    listEl.innerHTML = `<p class="p-3 text-red-600">${data.message || 'Failed to load notifications'}</p>`;
                    return;
                }
                const items = data.items || [];
                const unread = items.filter(n => Number(n.is_read || 0) === 0).length;
                badgeEl.textContent = String(unread);
                badgeEl.style.display = unread > 0 ? 'inline-block' : 'none';
                listEl.innerHTML = items.length ? items.map(n => `
                    <div class="p-3 border-b hover:bg-gray-50 ${Number(n.is_read || 0) === 0 ? 'bg-blue-50' : ''}">
                        <p class="font-medium">${n.title || 'Notification'}</p>
                        <p class="text-xs text-gray-600">${n.message || ''}</p>
                        <p class="text-[11px] text-gray-400 mt-1">${n.created_at || ''}</p>
                    </div>
                `).join('') : '<p class="p-3 text-gray-500">No notifications</p>';
            } catch (e) {
                listEl.innerHTML = '<p class="p-3 text-red-600">Failed to load notifications</p>';
            }
        }

        async function markAllNotificationsRead() {
            try {
                await fetch(`${API_BASE}/notifications/mark-read`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ all: true })
                });
                loadNotifications();
            } catch (e) {
                // no-op
            }
        }

        // Show section
        function showSection(sectionId) {
            // Hide all sections
            const sections = document.querySelectorAll('.content-section');
            sections.forEach(section => {
                section.classList.add('hidden');
                section.classList.remove('fade-in');
            });

            // Show selected section
            const selectedSection = document.getElementById(sectionId);
            if (selectedSection) {
                selectedSection.classList.remove('hidden');
                selectedSection.classList.add('fade-in');
            }

            // Update sidebar active state
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => {
                item.classList.remove('active');
            });
            const activeLink = document.querySelector(`.sidebar-item[onclick*="showSection('${sectionId}')"]`);
            if (activeLink) activeLink.classList.add('active');

            // Specific section loading
            if (sectionId === 'notes') {
                loadSubjectsForSelect();
                loadMaterialsFilterSubjects();
                loadMaterials();
                loadFacultyAcademicCalendar();
            }
            if (sectionId === 'attendance') loadAttendanceMarking();
            if (sectionId === 'analytics') loadFacultyAnalytics();
            if (sectionId === 'students') {
                loadFacultyStudents();
                loadGradeSubjects();
            }
            if (sectionId === 'assignments') loadFacultyAssignments();
            if (sectionId === 'voice-notes') loadVoiceNotes();
            if (sectionId === 'placements-admin') loadMockInterviews();
            if (sectionId === 'flashcards-admin') loadFlashcards();
        }

        async function loadFacultyAssignments() {
            const list = document.getElementById('facultyAssignmentsList');
            try {
                const res = await fetch(`${API_BASE}/assignments`, { headers: masterAuthHeaders() });
                const data = await res.json();
                list.innerHTML = data.items.map(a => `
                    <div class="p-4 bg-white rounded-lg shadow-sm border border-l-4 border-l-orange-500">
                        <div class="flex justify-between items-start mb-2">
                            <h4 class="font-bold">${a.title}</h4>
                            <span class="text-xs font-bold text-gray-500">${new Date(a.due_date).toLocaleDateString()}</span>
                        </div>
                        <p class="text-sm text-gray-600 mb-4">${a.description}</p>
                        <button class="text-blue-600 text-xs font-bold hover:underline">View Submissions</button>
                    </div>
                `).join('') || '<p class="text-gray-500">No assignments created.</p>';
            } catch (err) { console.error(err); }
        }

        async function openCreateAssignmentModal() {
            const select = document.getElementById('assignSubject');
            try {
                const res = await fetch(`${API_BASE}/master/subjects`, { headers: masterAuthHeaders() });
                const data = await res.json();
                select.innerHTML = data.items.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
                openModal('createAssignmentModal');
            } catch (err) { console.error(err); }
        }

        async function createAssignment(event) {
            event.preventDefault();
            const payload = {
                subject_id: document.getElementById('assignSubject').value,
                title: document.getElementById('assignTitle').value,
                due_date: document.getElementById('assignDue').value,
                description: document.getElementById('assignDesc').value
            };
            try {
                const res = await fetch(`${API_BASE}/assignments`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify(payload)
                });
                if (res.ok) {
                    showToast('Assignment created!', 'success');
                    closeModal('createAssignmentModal');
                    loadFacultyAssignments();
                }
            } catch (err) { showToast('Failed to create', 'error'); }
        }

        async function loadGradeSubjects() {
            const sel = document.getElementById('gradeSubjectId');
            if (!sel) return;
            try {
                const res = await fetch(`${API_BASE}/master/subjects`, { headers: masterAuthHeaders() });
                const data = await res.json();
                sel.innerHTML = '<option value="">Select subject</option>' +
                    (data.items || []).map(s =>
                        `<option value="${s.id}">${s.name} (${s.code || '—'})</option>`
                    ).join('');
            } catch (e) { /* no-op */ }
        }

        async function saveFacultyGrade() {
            const statusEl = document.getElementById('gradeSaveStatus');
            const preview = document.getElementById('gradePreviewSummary');
            const payload = {
                student_id: Number(document.getElementById('gradeStudentId')?.value),
                subject_id: Number(document.getElementById('gradeSubjectId')?.value),
                grade_points: document.getElementById('gradePoints')?.value,
                status: document.getElementById('gradeStatus')?.value || 'pending',
            };
            if (!payload.student_id || !payload.subject_id) {
                showToast('Student ID and subject required', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/academic/gpa/grades`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify(payload),
                });
                const data = await res.json();
                if (res.ok) {
                    showToast('Grade saved', 'success');
                    if (statusEl) statusEl.textContent = 'Saved successfully.';
                    if (preview && data.summary) {
                        preview.classList.remove('hidden');
                        preview.innerHTML = `Student CGPA: <strong>${data.summary.cgpa ?? 'N/A'}</strong> · Credits: ${data.summary.credits_earned} · Backlogs: ${data.summary.backlogs}`;
                    }
                } else {
                    showToast(data.message || 'Failed', 'error');
                    if (statusEl) statusEl.textContent = data.message || 'Failed';
                }
            } catch (e) {
                showToast('Failed to save grade', 'error');
            }
        }

        async function loadFacultyStudents() {
            const search = document.getElementById('facultySearchStudent').value;
            const list = document.getElementById('facultyStudentsList');
            if (!list) return;
            try {
                const res = await fetch(`${API_BASE}/students?search=${encodeURIComponent(search || '')}&paged=1&page_size=50`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                const rows = data.items || data || [];
                list.innerHTML = rows.map(s => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <img class="h-8 w-8 rounded-full" src="https://picsum.photos/seed/student${s.id}/40/40" alt="">
                                <div class="ml-3">
                                    <div class="text-sm font-medium text-gray-900">${s.name}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">#${s.id}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${s.department_name || 'General'}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center gap-2">
                                <div class="w-16 bg-gray-200 rounded-full h-1.5">
                                    <div class="bg-blue-500 h-1.5 rounded-full" style="width: ${s.attendance}%"></div>
                                </div>
                                <span class="text-xs font-bold">${s.attendance}%</span>
                                <button type="button" onclick="document.getElementById('gradeStudentId').value=${s.id}" class="text-xs text-indigo-600 font-bold hover:underline ml-1">Grade</button>
                            </div>
                        </td>
                    </tr>
                `).join('') || '<tr><td colspan="4" class="p-4 text-center text-gray-500">No students found.</td></tr>';
            } catch (err) {
                console.error(err);
            }
        }    // Close sidebar on mobile after selection
            if (window.innerWidth <= 768) {
                const sidebar = document.querySelector('.sidebar');
                if (sidebar.classList.contains('active')) {
