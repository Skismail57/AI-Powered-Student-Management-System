                                <div class="ml-3">
                                    <div class="text-sm font-medium text-gray-900">${s.name}</div>
                                    <div class="text-xs text-gray-500">${s.department_name || 'General'}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">#${s.id}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-center">
