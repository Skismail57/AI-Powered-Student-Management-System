                        </div>
                    </div>

                    <div class="department-card card-shadow" onclick="showDepartmentDetails('mechanical')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-cogs text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">240 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Mechanical Engineering</h3>
                        <p class="text-sm text-gray-600 mb-3">Thermodynamics, manufacturing, machine design, robotics</p>
                        <div class="flex items-center text-sm text-gray-500">
                            <i class="fas fa-book mr-2"></i>
                            <span>16 Courses</span>
                        </div>
                    </div>

                    <div class="department-card card-shadow" onclick="showDepartmentDetails('automobile')">
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-car text-blue-600 text-xl"></i>
                            </div>
                            <span class="text-sm text-gray-500">180 Students</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Automobile Engineering</h3>
                        <p class="text-sm text-gray-600 mb-3">Vehicle design, automotive systems, engine technology</p>
                        <div class="flex items-center text-sm text-gray-500">
                            <i class="fas fa-book mr-2"></i>
                            <span>13 Courses</span>
                        </div>
