                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ subject, title, resource_type, content_url, description })
                });
                const data = await res.json();
                if (!res.ok) {
