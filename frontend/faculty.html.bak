        async function markAttendance(studentId, status) {
            const date = document.getElementById('attendanceDate').value;
            try {
                const res = await fetch(`${API_BASE}/attendance`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify({ student_id: studentId, status, date, notes: 'Faculty marking' })
                });
                if (res.ok) {
                    showToast(`Marked ${status} for Student #${studentId}`, 'success');
                } else {
                    showToast('Failed to mark attendance', 'error');
                }
            } catch (err) {
                showToast('Failed to mark attendance', 'error');
            }
        }

        async function loadSubjectsForSelect() {
            const select = document.getElementById('materialSubject');
            if (!select) return;
            try {
                const res = await fetch(`${API_BASE}/master/subjects`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                select.innerHTML = '<option value="">Select Subject</option>' + 
                    data.items.map(sub => `<option value="${sub.id}">${sub.name} (${sub.department_name})</option>`).join('');
            } catch (err) {
                console.error(err);
            }
        }

        function openUploadModal() {
            loadSubjectsForSelect();
            openModal('uploadMaterialModal');
        }

        // Toggle chatbot
        function toggleChatbot() {
            const chatbotWindow = document.getElementById('chatbotWindow');
            chatbotWindow.style.display = chatbotWindow.style.display === 'flex' ? 'none' : 'flex';
        }

        // Send chatbot message
        function sendChatbotMessage() {
            const input = document.getElementById('chatbotInput');
            const message = input.value.trim();
            
            if (message) {
                const messagesContainer = document.getElementById('chatbotMessages');
                
                // Add user message
                const userMessage = document.createElement('div');
                userMessage.className = 'message user';
                userMessage.textContent = message;
                messagesContainer.appendChild(userMessage);
                
                // Clear input
                input.value = '';
                
                // Simulate bot response
                setTimeout(() => {
                    const botMessage = document.createElement('div');
                    botMessage.className = 'message bot';
                    
                    // Simple response logic
                    let response = "I'm here to help! Could you please provide more details?";
                    
                    if (message.toLowerCase().includes('student')) {
                        response = "I can help you with student-related queries. You can add, edit, or view student information in the Students section.";
                    } else if (message.toLowerCase().includes('department')) {
                        response = "For department management, please visit the Departments section where you can view all departments and their details.";
                    } else if (message.toLowerCase().includes('course')) {
                        response = "Course information is available in the Courses section. You can manage courses there.";
                    } else if (message.toLowerCase().includes('faculty')) {
                        response = "Faculty management is available in the Faculty section. You can add or view faculty members there.";
                    } else if (message.toLowerCase().includes('report')) {
                        response = "You can generate various reports in the Reports & Analytics section. Custom reports are also available.";
                    }
                    
                    botMessage.textContent = response;
                    messagesContainer.appendChild(botMessage);
                    
                    // Scroll to bottom
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }, 1000);
                
                // Scroll to bottom
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }
        }

        // Handle chatbot input enter key
        function handleChatbotInput(event) {
            if (event.key === 'Enter') {
                sendChatbotMessage();
            }
        }

        // Open modal
        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'flex';
        }

        // Close modal
        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Add department
        function addDepartment(event) {
            event.preventDefault();
            // Here you would normally send data to server
            alert('Department added successfully!');
            closeModal('addDepartmentModal');
        }

        // Load dashboard data
        async function loadDashboard() {
            try {
                const [dashboardRes, paymentsRes] = await Promise.all([
                    fetch(`${API_BASE}/dashboard`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                    }),
                    fetch(`${API_BASE}/payments`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                    })
                ]);
                
                const data = await dashboardRes.json();
                const payments = await paymentsRes.json();
                
                // Update stats with real data
                const totalStudentsEl = document.querySelector('#dashboard .stats-card:nth-child(1) .text-3xl');
                if (totalStudentsEl) totalStudentsEl.textContent = data.total_students;
            } catch (err) {
                console.error(err);
            }
        }

        async function markAttendanceWithReason() {
            const studentId = Number(document.getElementById('attStudentId')?.value || 0);
            const date = document.getElementById('attDate')?.value || '';
            const status = document.getElementById('attStatus')?.value || 'present';
            const reason = document.getElementById('attReason')?.value || '';
            if (!studentId || !date) {
                showToast('Student ID and date are required', 'error');
                return;
            }
            if (status === 'absent' && !reason) {
                showToast('Reason is required when status is absent', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/attendance`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ student_id: studentId, date, status, reason, notes: '' })
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.message || 'Failed to mark attendance', 'error');
                    return;
                }
                showToast('Attendance marked successfully', 'success');
                loadAttendanceReasonSummary();
            } catch (e) {
                showToast('Failed to mark attendance', 'error');
            }
        }

        async function createAssignment() {
            const title = document.getElementById('assignmentTitle')?.value?.trim() || '';
            const description = document.getElementById('assignmentDesc')?.value?.trim() || '';
            const due_date = document.getElementById('assignmentDueDate')?.value || '';
            if (!title) {
                showToast('Assignment title is required', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/assignments`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ title, description, due_date })
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.message || 'Failed to create assignment', 'error');
                    return;
                }
                document.getElementById('assignmentTitle').value = '';
                document.getElementById('assignmentDesc').value = '';
                document.getElementById('assignmentDueDate').value = '';
                showToast('Assignment created', 'success');
                loadAssignmentsPanel();
            } catch (err) {
                showToast('Failed to create assignment', 'error');
            }
        }

        function openSearchPreset(query) {
            window.location.href = `search.html?q=${encodeURIComponent(query || '')}`;
        }

        async function sendQuickMessage() {
            const recipient_role = (document.getElementById('quickMsgRole')?.value || '').trim();
            const recipient_id = Number(document.getElementById('quickMsgRecipientId')?.value || 0);
            const body = (document.getElementById('quickMsgBody')?.value || '').trim();
            const statusEl = document.getElementById('quickMsgStatus');
            if (!recipient_role || !recipient_id || !body) {
                if (statusEl) statusEl.textContent = 'recipient role, id and message are required';
                return;
            }
            if (statusEl) statusEl.textContent = 'sending...';
            try {
                const res = await fetch(`${API_BASE}/messages/send`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ recipient_role, recipient_id, body })
                });
                const data = await res.json();
                if (!res.ok) {
                    if (statusEl) statusEl.textContent = data.message || 'failed to send';
                    return;
                }
                document.getElementById('quickMsgBody').value = '';
                if (statusEl) statusEl.textContent = 'sent';
                loadFacultyRecentContacts();
                loadQuickMessageThread();
            } catch (e) {
                if (statusEl) statusEl.textContent = 'failed to send';
            }
        }

        async function loadQuickMessageThread() {
            const peer_role = (document.getElementById('quickMsgRole')?.value || '').trim();
            const peer_id = Number(document.getElementById('quickMsgRecipientId')?.value || 0);
            const threadEl = document.getElementById('quickMsgThread');
            if (!threadEl) return;
            if (!peer_role || peer_id <= 0) {
                threadEl.innerHTML = '<p class="text-gray-500">Enter peer role and ID.</p>';
                return;
            }
            threadEl.innerHTML = '<p class="text-gray-500">Loading thread...</p>';
            try {
                const res = await fetch(`${API_BASE}/messages/inbox?peer_role=${encodeURIComponent(peer_role)}&peer_id=${peer_id}&limit=30`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    threadEl.innerHTML = `<p class="text-red-600">${data.message || 'Failed to load thread'}</p>`;
                    return;
                }
                const me = JSON.parse(localStorage.getItem('user') || '{}');
                const items = (data.items || []).slice().reverse();
                facultyThreadItems = items;
                const unreadCount = items.filter(m => String(m.recipient_role || '') === 'faculty' && Number(m.recipient_id || 0) === Number(me.id || 0) && Number(m.is_read || 0) === 0).length;
                const unreadEl = document.getElementById('quickMsgUnreadCount');
                if (unreadEl) unreadEl.textContent = `Unread in thread: ${unreadCount}`;
                renderFacultyThread();
            } catch (e) {
                threadEl.innerHTML = '<p class="text-red-600">Failed to load thread.</p>';
            }
        }

        function renderFacultyThread() {
            const threadEl = document.getElementById('quickMsgThread');
            if (!threadEl) return;
            const me = JSON.parse(localStorage.getItem('user') || '{}');
            const q = (document.getElementById('quickMsgThreadSearch')?.value || '').trim().toLowerCase();
            const items = (facultyThreadItems || []).filter(m => !q || String(m.body || '').toLowerCase().includes(q));
            threadEl.innerHTML = items.length ? items.map(m => {
                const isMine = Number(m.sender_id || 0) === Number(me.id || 0) && String(m.sender_role || '') === 'faculty';
                const canMarkRead = !isMine && Number(m.is_read || 0) === 0 && String(m.recipient_role || '') === 'faculty' && Number(m.recipient_id || 0) === Number(me.id || 0);
                return `
                    <div class="p-2 rounded border ${isMine ? 'bg-emerald-50 border-emerald-200' : 'bg-slate-50 border-slate-200'}">
                        <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
                            <p>${m.sender_role}#${m.sender_id} -> ${m.recipient_role}#${m.recipient_id}</p>
                            <p>${m.created_at || ''}</p>
                        </div>
                        <p class="text-sm mt-1">${m.body || ''}</p>
                        ${canMarkRead ? `<button onclick="markFacultyThreadMessageRead(${m.id})" class="mt-1 text-[11px] px-2 py-1 rounded border hover:bg-white">Mark read</button>` : ''}
                    </div>
                `;
            }).join('') : '<p class="text-gray-500">No messages match this thread filter.</p>';
        }

        async function markFacultyThreadMessageRead(messageId) {
            try {
                await fetch(`${API_BASE}/messages/mark-read`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id: messageId })
                });
            } catch (e) {
                // no-op
            }
            loadQuickMessageThread();
        }

        function applyFacultyRecentContact(value) {
            if (!value) return;
            const [role, id] = String(value).split(':');
            if (!role || !id) return;
            const roleEl = document.getElementById('quickMsgRole');
            const idEl = document.getElementById('quickMsgRecipientId');
            if (roleEl) roleEl.value = role;
            if (idEl) idEl.value = id;
            loadQuickMessageThread();
        }

        async function loadFacultyRecentContacts() {
            const selectEl = document.getElementById('quickMsgRecentContacts');
            if (!selectEl) return;
            try {
                const res = await fetch(`${API_BASE}/messages/inbox?limit=120`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) return;
                const me = JSON.parse(localStorage.getItem('user') || '{}');
                const map = new Map();
                (data.items || []).forEach(m => {
                    const senderRole = String(m.sender_role || '');
                    const recipientRole = String(m.recipient_role || '');
                    const senderId = Number(m.sender_id || 0);
                    const recipientId = Number(m.recipient_id || 0);
                    const isSenderMe = senderRole === 'faculty' && senderId === Number(me.id || 0);
                    const peerRole = isSenderMe ? recipientRole : senderRole;
                    const peerId = isSenderMe ? recipientId : senderId;
                    if (!peerRole || peerId <= 0) return;
                    const key = `${peerRole}:${peerId}`;
                    if (!map.has(key)) map.set(key, { role: peerRole, id: peerId });
                });
                const contacts = Array.from(map.values()).slice(0, 25);
                selectEl.innerHTML = '<option value="">Recent contacts</option>' + contacts.map(c => `<option value="${c.role}:${c.id}">${c.role}#${c.id}</option>`).join('');
            } catch (e) {
                // no-op
            }
        }

        function exportFacultyThreadCsv() {
            const items = facultyThreadItems || [];
            if (!items.length) return;
            const headers = ['id', 'sender_role', 'sender_id', 'recipient_role', 'recipient_id', 'body', 'is_read', 'created_at'];
            const escapeCsv = (v) => {
                const s = String(v ?? '');
                return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
            };
            const rows = [headers.join(','), ...items.map(x => headers.map(h => escapeCsv(x[h])).join(','))];
            const blob = new Blob([rows.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `faculty_thread_${Date.now()}.csv`;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }

        async function createClassPlan() {
            const class_name = (document.getElementById('classPlanName')?.value || '').trim();
            const subject = (document.getElementById('classPlanSubject')?.value || '').trim();
            const schedule_time = (document.getElementById('classPlanTime')?.value || '').trim();
            const syllabus_url = (document.getElementById('classPlanSyllabus')?.value || '').trim();
            if (!class_name || !subject || !schedule_time) {
                showToast('Class, subject and schedule time are required', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/faculty/class-planner`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ class_name, subject, schedule_time, syllabus_url })
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.message || 'Failed to create class plan', 'error');
                    return;
                }
                showToast('Class plan created', 'success');
                document.getElementById('classPlanName').value = '';
                document.getElementById('classPlanSubject').value = '';
                document.getElementById('classPlanTime').value = '';
                document.getElementById('classPlanSyllabus').value = '';
                loadClassPlans();
            } catch (e) {
                showToast('Failed to create class plan', 'error');
            }
        }

        async function loadClassPlans() {
            const wrap = document.getElementById('classPlansList');
            if (!wrap) return;
            try {
                const res = await fetch(`${API_BASE}/faculty/class-planner?limit=20`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    wrap.innerHTML = `<p>${data.message || 'Failed to load class plans'}</p>`;
                    return;
                }
                const items = data.items || [];
                wrap.innerHTML = items.length ? items.map(p => `
                    <div class="p-2 border rounded bg-white">
                        <p class="font-medium">${p.class_name} • ${p.subject}</p>
                        <p class="text-xs text-gray-500">${p.schedule_time} • ${String(p.status || '').toUpperCase()} • ${Number(p.completion_pct || 0).toFixed(0)}%</p>
                        <div class="mt-2 flex items-center gap-2">
                            <input id="classPlanPct-${p.id}" type="number" min="0" max="100" value="${Number(p.completion_pct || 0).toFixed(0)}" class="form-input w-20 text-xs" />
                            <select id="classPlanStatus-${p.id}" class="form-input text-xs">
                                <option value="scheduled" ${p.status === 'scheduled' ? 'selected' : ''}>Scheduled</option>
                                <option value="ongoing" ${p.status === 'ongoing' ? 'selected' : ''}>Ongoing</option>
                                <option value="completed" ${p.status === 'completed' ? 'selected' : ''}>Completed</option>
                                <option value="cancelled" ${p.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
                            </select>
                            <button onclick="updateClassPlan(${p.id})" class="px-2 py-1 text-xs border rounded hover:bg-gray-50">Update</button>
                        </div>
                    </div>
                `).join('') : '<p>No class plans yet.</p>';
            } catch (e) {
                wrap.innerHTML = '<p>Failed to load class plans.</p>';
            }
        }

        async function updateClassPlan(planId) {
            const completion_pct = Number(document.getElementById(`classPlanPct-${planId}`)?.value || 0);
            const status = document.getElementById(`classPlanStatus-${planId}`)?.value || 'scheduled';
            try {
                const res = await fetch(`${API_BASE}/faculty/class-planner/${planId}`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ completion_pct, status })
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.message || 'Failed to update class plan', 'error');
                    return;
                }
                showToast('Class plan updated', 'success');
                loadClassPlans();
            } catch (e) {
                showToast('Failed to update class plan', 'error');
            }
        }

        async function loadFacultyMeetings() {
            const wrap = document.getElementById('facultyMeetingsList');
            if (!wrap) return;
            try {
                const res = await fetch(`${API_BASE}/meetings?limit=20`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    wrap.innerHTML = `<p>${data.message || 'Failed to load meetings'}</p>`;
                    return;
                }
                const items = (data.items || []).filter(m => ['requested', 'rescheduled', 'approved'].includes(String(m.status || '').toLowerCase()));
                wrap.innerHTML = items.length ? items.map(m => `
                    <div class="p-2 border rounded bg-violet-50 border-violet-200">
                        <p class="font-medium">${m.parent_name || 'Parent'} • Student: ${m.student_name || `#${m.student_id}`}</p>
                        <p class="text-xs text-gray-600">Requested: ${m.requested_time || '-'} • Status: ${String(m.status || '').toUpperCase()}</p>
                        <div class="mt-2 flex flex-wrap items-center gap-2">
                            <input id="meetingTime-${m.id}" class="form-input text-xs" placeholder="Scheduled time" value="${m.scheduled_time || m.requested_time || ''}" />
                            <button onclick="updateMeetingStatus(${m.id}, 'approved')" class="px-2 py-1 text-xs rounded border bg-emerald-600 text-white">Approve</button>
                            <button onclick="updateMeetingStatus(${m.id}, 'rescheduled')" class="px-2 py-1 text-xs rounded border bg-amber-600 text-white">Reschedule</button>
                            <button onclick="updateMeetingStatus(${m.id}, 'rejected')" class="px-2 py-1 text-xs rounded border bg-rose-600 text-white">Reject</button>
                        </div>
                    </div>
                `).join('') : '<p>No active meeting requests.</p>';
            } catch (e) {
                wrap.innerHTML = '<p>Failed to load meetings.</p>';
            }
        }

        async function updateMeetingStatus(meetingId, status) {
            const time = (document.getElementById(`meetingTime-${meetingId}`)?.value || '').trim();
