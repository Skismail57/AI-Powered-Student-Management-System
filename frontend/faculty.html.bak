        async function runAutoEvaluation() {
            const file = document.getElementById('autoEvalCsvFile')?.files?.[0];
            const wrap = document.getElementById('autoEvalResult');
            if (!file) {
                showToast('Please choose a CSV file', 'error');
                return;
            }
            if (wrap) wrap.innerHTML = '<p>Running evaluation...</p>';
            try {
                const fd = new FormData();
                fd.append('file', file);
                const res = await fetch(`${API_BASE}/faculty/auto-evaluation/upload`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` },
                    body: fd
                });
                const data = await res.json();
                if (!res.ok) {
                    if (wrap) wrap.innerHTML = `<p>${data.message || 'Evaluation failed'}</p>`;
                    return;
                }
                if (wrap) {
                    const weak = data.weak_items || [];
                    wrap.innerHTML = `
                        <p><strong>Run #${data.run_id}</strong></p>
                        <p>Processed: ${data.processed} / ${data.total_rows}</p>
                        <p>Class Average: ${data.class_average}</p>
                        <p>Weak Students (&lt;40): ${data.weak_students}</p>
                        <div class="mt-2">
                            ${weak.length ? weak.slice(0, 8).map(w => `<p>• ${w.name} (#${w.student_id}) → ${w.marks}</p>`).join('') : '<p>No weak students detected.</p>'}
                        </div>
                    `;
                }
                showToast('Auto evaluation completed', 'success');
            } catch (e) {
                if (wrap) wrap.innerHTML = '<p>Evaluation failed.</p>';
                showToast('Evaluation failed', 'error');
            }
        }

