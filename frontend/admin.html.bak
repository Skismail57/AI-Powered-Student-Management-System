                                <span><i class="fas fa-users mr-1"></i> 55 Students</span>
                                <span><i class="fas fa-clock mr-1"></i> 3 Credits</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md overflow-hidden">
                        <div class="h-48 bg-gradient-to-br from-yellow-400 to-yellow-600 flex items-center justify-center">
                            <i class="fas fa-building text-white text-6xl"></i>
                        </div>
                        <div class="p-6">
                            <div class="flex justify-between items-start mb-2">
