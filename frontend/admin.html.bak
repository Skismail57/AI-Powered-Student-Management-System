            <!-- Students Section -->
            <section id="students" class="content-section hidden">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Students Management</h2>
                    <div class="flex space-x-3">
                        <button class="btn-primary" onclick="openAddStudentModal()">
                            <i class="fas fa-user-plus mr-2"></i>Add Student
                        </button>
                        <button onclick="downloadStudentsReport('pdf')" class="bg-white border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition">
                            <i class="fas fa-download mr-2"></i>Export PDF
                        </button>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="p-4 border-b">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between space-y-3 md:space-y-0">
                            <div class="flex flex-wrap items-center gap-3">
                                <div class="relative">
                                    <input type="text" id="searchStudent" placeholder="Search students..." class="form-input pl-10 w-64">
                                    <i class="fas fa-search absolute left-3 top-3.5 text-gray-400"></i>
                                </div>
                                <select id="filterAttendance" class="form-input w-48">
                                    <option value="all">All Students</option>
                                    <option value="low">Low Attendance (&lt; 60%)</option>
                                    <option value="medium">Medium Attendance (60-75%)</option>
                                    <option value="high">High Attendance (&gt; 75%)</option>
                                </select>
                                <select id="filterRisk" class="form-input w-48">
                                    <option value="all">All Risk Levels</option>
                                    <option value="atrisk">At-Risk Students</option>
                                    <option value="warning">Warning Students</option>
                                    <option value="good">Good Standing</option>
                                </select>
                                <select id="filterPerformance" class="form-input w-48">
                                    <option value="all">All Performance</option>
                                    <option value="high">High Performers</option>
                                    <option value="weak">Needs Improvement</option>
                                </select>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="downloadStudentsReport('csv')" class="bg-white border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition">
                                    <i class="fas fa-file-csv mr-2"></i>CSV
                                </button>
                                <button onclick="downloadStudentsReport('xlsx')" class="bg-white border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition">
                                    <i class="fas fa-file-excel mr-2"></i>Excel
                                </button>
                                <button onclick="downloadStudentsReport('pdf')" class="bg-white border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-50 transition">
                                    <i class="fas fa-file-pdf mr-2"></i>PDF
                                </button>
                                <button onclick="resetFilters()" class="bg-gray-100 border border-gray-300 px-4 py-2 rounded-lg hover:bg-gray-200 transition">
                                    <i class="fas fa-redo mr-2"></i>Reset
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full table-hover">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
