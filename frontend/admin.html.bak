    <!-- AI Chatbot -->
    <div class="chatbot-container">
        <div class="chatbot-bubble" onclick="toggleChatbot()">
            <i class="fas fa-robot text-white text-2xl"></i>
        </div>
        <div class="chatbot-window" id="chatbotWindow">
            <div class="chatbot-header">
                <i class="fas fa-robot mr-2"></i>AI Assistant
            </div>
            <div class="chatbot-messages" id="chatbotMessages">
                <div class="message bot">
                    Hello! I'm your AI assistant. How can I help you with the Student Management System today?
                </div>
            </div>
            <div class="chatbot-input">
                <input type="text" id="chatbotInput" placeholder="Type your message..." onkeypress="handleChatbotInput(event)">
                <button onclick="sendChatbotMessage()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <!-- Add Department Modal -->
    <div id="addDepartmentModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('addDepartmentModal')">&times;</span>
            <h2 class="text-2xl font-bold mb-4">Add New Department</h2>
            <form onsubmit="addDepartment(event)">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Department Name</label>
                    <input type="text" class="form-input" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Department Code</label>
                    <input type="text" class="form-input" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Head of Department</label>
                    <input type="text" class="form-input" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea class="form-input" rows="3"></textarea>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" onclick="closeModal('addDepartmentModal')">Cancel</button>
                    <button type="submit" class="btn-primary">Add Department</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Student Modal -->
    <div id="addStudentModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('addStudentModal')">&times;</span>
            <h2 class="text-2xl font-bold mb-4">Add New Student</h2>
            <form onsubmit="addStudent(event)">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                        <input type="text" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                        <input type="text" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Student ID</label>
                        <input type="text" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
                        <select class="form-input" required>
                            <option value="">Select Department</option>
                            <option>AI & ML Engineering</option>
                            <option>Computer Science Engineering</option>
                            <option>Information Science Engineering</option>
                            <option>Civil Engineering</option>
                            <option>Electrical & Electronics Engineering</option>
                            <option>Mechanical Engineering</option>
                            <option>Automobile Engineering</option>
                            <option>Pharmacy</option>
                            <option>Medical Sciences</option>
                            <option>MBA</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Year</label>
                        <select class="form-input" required>
                            <option value="">Select Year</option>
                            <option>1st Year</option>
                            <option>2nd Year</option>
                            <option>3rd Year</option>
                            <option>4th Year</option>
                        </select>
                    </div>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" onclick="closeModal('addStudentModal')">Cancel</button>
                    <button type="submit" class="btn-primary">Add Student</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Course Modal -->
    <div id="addCourseModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('addCourseModal')">&times;</span>
            <h2 class="text-2xl font-bold mb-4">Add New Course</h2>
            <form onsubmit="addCourse(event)">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Course Name</label>
                    <input type="text" class="form-input" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Course Code</label>
                    <input type="text" class="form-input" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
                    <select class="form-input" required>
                        <option value="">Select Department</option>
                        <option>AI & ML Engineering</option>
                        <option>Computer Science Engineering</option>
                        <option>Information Science Engineering</option>
                        <option>Civil Engineering</option>
                        <option>Electrical & Electronics Engineering</option>
                        <option>Mechanical Engineering</option>
                        <option>Automobile Engineering</option>
                        <option>Pharmacy</option>
                        <option>Medical Sciences</option>
                        <option>MBA</option>
                    </select>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Credits</label>
                        <input type="number" class="form-input" min="1" max="6" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Semester</label>
                        <select class="form-input" required>
                            <option value="">Select Semester</option>
                            <option>1</option>
                            <option>2</option>
                            <option>3</option>
                            <option>4</option>
                            <option>5</option>
                            <option>6</option>
                            <option>7</option>
                            <option>8</option>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea class="form-input" rows="3"></textarea>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" onclick="closeModal('addCourseModal')">Cancel</button>
                    <button type="submit" class="btn-primary">Add Course</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Faculty Modal -->
    <div id="addFacultyModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal('addFacultyModal')">&times;</span>
            <h2 class="text-2xl font-bold mb-4">Add New Faculty</h2>
            <form onsubmit="addFaculty(event)">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                        <input type="text" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                        <input type="text" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Employee ID</label>
                        <input type="text" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" class="form-input" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
                        <select class="form-input" required>
                            <option value="">Select Department</option>
                            <option>AI & ML Engineering</option>
                            <option>Computer Science Engineering</option>
                            <option>Information Science Engineering</option>
                            <option>Civil Engineering</option>
                            <option>Electrical & Electronics Engineering</option>
                            <option>Mechanical Engineering</option>
                            <option>Automobile Engineering</option>
                            <option>Pharmacy</option>
                            <option>Medical Sciences</option>
                            <option>MBA</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Position</label>
                        <select class="form-input" required>
                            <option value="">Select Position</option>
                            <option>Professor</option>
                            <option>Associate Professor</option>
                            <option>Assistant Professor</option>
                            <option>Lecturer</option>
                        </select>
                    </div>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50" onclick="closeModal('addFacultyModal')">Cancel</button>
                    <button type="submit" class="btn-primary">Add Faculty</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <script>
        const API_BASE = 'http://localhost:5000';
        const socket = io(API_BASE);
        let attendanceTrendChart = null;
        let riskDistributionChart = null;
        let monitorInterval = null;
        let healthCheckInterval = null;
        let adminThreadItems = [];
        
        document.addEventListener('DOMContentLoaded', () => {
            const user = JSON.parse(localStorage.getItem('user'));
            const token = localStorage.getItem('token');
            
            if (!token || user.role !== 'admin') {
                window.location.href = 'login.html';
                return;
            }

            document.getElementById('adminName').textContent = user.name;

            document.getElementById('logoutBtn').addEventListener('click', () => {
                if (monitorInterval) clearInterval(monitorInterval);
                if (healthCheckInterval) clearInterval(healthCheckInterval);
                localStorage.removeItem('token');
                localStorage.removeItem('user');
                window.location.href = 'login.html';
            });

            const toggleErrorsBtn = document.getElementById('toggleErrorsBtn');
            const clearErrorsBtn = document.getElementById('clearErrorsBtn');
            const monitorErrorsWrap = document.getElementById('monitorErrorsWrap');
            if (toggleErrorsBtn && monitorErrorsWrap) {
                toggleErrorsBtn.addEventListener('click', () => {
                    const isHidden = monitorErrorsWrap.classList.contains('hidden');
                    monitorErrorsWrap.classList.toggle('hidden');
                    toggleErrorsBtn.textContent = isHidden ? 'Hide last errors' : 'View last errors';
                });
            }
            if (clearErrorsBtn) {
                clearErrorsBtn.addEventListener('click', () => {
                    const errorsListEl = document.getElementById('monitorErrorsList');
                    if (errorsListEl) {
                        errorsListEl.innerHTML = `<div class="p-3 text-gray-500">Cleared for demo view.</div>`;
                    }
                });
            }

            // Load dashboard data
            loadDashboard();
            loadMonitoringStats();
            loadStudents(1);
            runButtonHealthCheck();
            loadAuditSnapshot();
            loadAdminRecentContacts();

            monitorInterval = setInterval(loadMonitoringStats, 10000);
            healthCheckInterval = setInterval(runButtonHealthCheck, 30000);

            const runHealthCheckBtn = document.getElementById('runHealthCheckBtn');
            if (runHealthCheckBtn) {
                runHealthCheckBtn.addEventListener('click', runButtonHealthCheck);
            }
            
            socket.on('dashboard_update', () => {
                loadDashboard();
                loadStudents(studentsPage || 1);
            });
            socket.on('message_push', () => {
                const peer_role = (document.getElementById('adminMsgRole')?.value || '').trim();
                const peer_id = Number(document.getElementById('adminMsgRecipientId')?.value || 0);
                if (peer_role && peer_id > 0) loadAdminMessageThread();
            });
        });

        let masterInstitutionsCache = [];

        function masterAuthHeaders() {
            return { 'Authorization': `Bearer ${localStorage.getItem('token')}` };
        }

        function masterAuthHeadersJson() {
            return { 'Authorization': `Bearer ${localStorage.getItem('token')}`, 'Content-Type': 'application/json' };
        }

        async function masterDataSectionOpened() {
            await masterRefreshInstitutions();
            masterPopulateInstitutionSelects();
            await masterRefreshDepartments();
            await masterRefreshSemesters();
            await masterLoadDeptOptionsForSubjects();
            await masterRefreshSubjects();
            await masterRefreshMaterials();
        }

        function masterPopulateInstitutionSelects() {
            const opts = '<option value="">Select institution</option>' + masterInstitutionsCache.map(i =>
                `<option value="${i.id}">${i.name.replace(/</g, '')}</option>`).join('');
            ['masterDeptInstId', 'masterSemInstId', 'masterSubInstId'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = opts;
            });
        }

        async function masterRefreshInstitutions() {
            const list = document.getElementById('masterInstList');
            const status = document.getElementById('masterInstStatus');
            if (!list) return;
            try {
                const res = await fetch(`${API_BASE}/master/institutions`, { headers: masterAuthHeaders() });
                const data = await res.json();
                if (!res.ok) {
                    list.innerHTML = `<p class="text-red-600">${data.message || 'Failed'}</p>`;
                    return;
                }
                masterInstitutionsCache = data.items || [];
                list.innerHTML = masterInstitutionsCache.length ? masterInstitutionsCache.map(i => `
                    <div class="flex justify-between items-center p-2 border rounded bg-gray-50">
                        <span><strong>${i.name}</strong> <span class="text-gray-500 text-xs">(${i.type || 'college'})</span></span>
                        <button type="button" onclick="masterDeleteInstitution(${i.id})" class="text-xs px-2 py-1 text-red-600 border border-red-200 rounded hover:bg-red-50">Delete</button>
                    </div>
                `).join('') : '<p class="text-gray-500">No institutions yet.</p>';
                masterPopulateInstitutionSelects();
                if (status) status.textContent = '';
            } catch (e) {
                list.innerHTML = '<p class="text-red-600">Failed to load institutions</p>';
            }
        }

        async function masterCreateInstitution() {
            const name = document.getElementById('masterInstName')?.value?.trim() || '';
            const type = document.getElementById('masterInstType')?.value?.trim() || 'college';
            const status = document.getElementById('masterInstStatus');
            if (!name) {
                if (status) status.textContent = 'Name required';
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/institutions`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify({ name, type })
                });
                const data = await res.json();
                if (status) status.textContent = res.ok ? 'Saved.' : (data.message || 'Failed');
                if (res.ok) {
                    document.getElementById('masterInstName').value = '';
                    await masterRefreshInstitutions();
                    await masterRefreshDepartments();
                    await masterRefreshSemesters();
                }
            } catch (e) {
                if (status) status.textContent = 'Request failed';
            }
        }

        async function masterDeleteInstitution(id) {
            if (!confirm('Delete this institution? Departments and semesters must be empty.')) return;
            try {
                await fetch(`${API_BASE}/master/institutions/${id}`, { method: 'DELETE', headers: masterAuthHeaders() });
                await masterRefreshInstitutions();
                await masterRefreshDepartments();
                await masterRefreshSemesters();
            } catch (e) { /* no-op */ }
        }

        async function masterRefreshDepartments() {
            const list = document.getElementById('masterDeptList');
            const status = document.getElementById('masterDeptStatus');
            const instId = document.getElementById('masterDeptInstId')?.value || '';
            if (!list) return;
            if (!instId) {
                list.innerHTML = '<p class="text-gray-500">Select an institution.</p>';
                return;
            }
            try {
                let url = `${API_BASE}/master/departments?institution_id=${encodeURIComponent(instId)}`;
                const sf = document.getElementById('masterDeptStreamFilter')?.value || '';
                if (sf) url += `&stream=${encodeURIComponent(sf)}`;
                const res = await fetch(url, { headers: masterAuthHeaders() });
                const data = await res.json();
                if (!res.ok) {
                    list.innerHTML = `<p class="text-red-600">${data.message || 'Failed'}</p>`;
                    return;
                }
                const items = data.items || [];
                list.innerHTML = items.length ? items.map(d => `
                    <div class="flex justify-between items-center p-2 border rounded bg-gray-50">
                        <span>${d.name} <span class="text-xs text-gray-500">(${d.stream})</span></span>
                        <button type="button" onclick="masterDeleteDepartment(${d.id})" class="text-xs px-2 py-1 text-red-600 border border-red-200 rounded hover:bg-red-50">Delete</button>
                    </div>
                `).join('') : '<p class="text-gray-500">No departments.</p>';
                if (status) status.textContent = '';
            } catch (e) {
                list.innerHTML = '<p class="text-red-600">Failed to load departments</p>';
            }
        }

        async function masterCreateDepartment() {
            const institution_id = Number(document.getElementById('masterDeptInstId')?.value || 0);
            const name = document.getElementById('masterDeptName')?.value?.trim() || '';
            const stream = document.getElementById('masterDeptStream')?.value || 'engineering';
            const status = document.getElementById('masterDeptStatus');
            if (!institution_id || !name) {
                if (status) status.textContent = 'Institution and name required';
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/departments`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify({ institution_id, name, stream })
                });
                const data = await res.json();
                if (status) status.textContent = res.ok ? 'Department added.' : (data.message || 'Failed');
                if (res.ok) {
                    document.getElementById('masterDeptName').value = '';
                    await masterRefreshDepartments();
                    await masterLoadDeptOptionsForSubjects();
                }
            } catch (e) {
                if (status) status.textContent = 'Request failed';
            }
        }

        async function masterDeleteDepartment(id) {
            if (!confirm('Delete department? Must have no subjects.')) return;
            try {
                await fetch(`${API_BASE}/master/departments/${id}`, { method: 'DELETE', headers: masterAuthHeaders() });
                await masterRefreshDepartments();
                await masterLoadDeptOptionsForSubjects();
                await masterRefreshSubjects();
            } catch (e) { /* no-op */ }
        }

        async function masterRefreshSemesters() {
            const list = document.getElementById('masterSemList');
            const status = document.getElementById('masterSemStatus');
            const instId = document.getElementById('masterSemInstId')?.value || '';
            if (!list) return;
            if (!instId) {
                list.innerHTML = '<p class="text-gray-500">Select an institution.</p>';
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/semesters?institution_id=${encodeURIComponent(instId)}`, { headers: masterAuthHeaders() });
                const data = await res.json();
                if (!res.ok) {
                    list.innerHTML = `<p class="text-red-600">${data.message || 'Failed'}</p>`;
                    return;
                }
                const items = data.items || [];
                list.innerHTML = items.length ? items.map(s => `
                    <div class="flex justify-between items-center p-2 border rounded bg-gray-50">
                        <span>${s.name} <span class="text-xs text-gray-500">(order ${s.order_index ?? 0})</span></span>
                        <button type="button" onclick="masterDeleteSemester(${s.id})" class="text-xs px-2 py-1 text-red-600 border border-red-200 rounded hover:bg-red-50">Delete</button>
                    </div>
                `).join('') : '<p class="text-gray-500">No semesters.</p>';
                if (status) status.textContent = '';
                await masterLoadSemesterOptionsForSubject();
            } catch (e) {
                list.innerHTML = '<p class="text-red-600">Failed to load semesters</p>';
            }
        }

        async function masterCreateSemester() {
            const institution_id = Number(document.getElementById('masterSemInstId')?.value || 0);
            const name = document.getElementById('masterSemName')?.value?.trim() || '';
            const order_index = Number(document.getElementById('masterSemOrder')?.value || 0);
            const status = document.getElementById('masterSemStatus');
            if (!institution_id || !name) {
                if (status) status.textContent = 'Institution and name required';
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/semesters`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify({ institution_id, name, order_index })
                });
                const data = await res.json();
                if (status) status.textContent = res.ok ? 'Semester added.' : (data.message || 'Failed');
                if (res.ok) {
                    document.getElementById('masterSemName').value = '';
                    await masterRefreshSemesters();
                }
            } catch (e) {
                if (status) status.textContent = 'Request failed';
            }
        }

        async function masterDeleteSemester(id) {
            if (!confirm('Delete semester? Linked subjects will have semester cleared.')) return;
            try {
                await fetch(`${API_BASE}/master/semesters/${id}`, { method: 'DELETE', headers: masterAuthHeaders() });
                await masterRefreshSemesters();
                await masterLoadSemesterOptionsForSubject();
            } catch (e) { /* no-op */ }
        }

        async function masterLoadDeptOptionsForSubjects() {
            const instId = document.getElementById('masterSubInstId')?.value || '';
            const deptSel = document.getElementById('masterSubDeptId');
            const matDeptSel = document.getElementById('masterMatDeptId');
            const emptyOpt = '<option value="">Select department</option>';
            if (!deptSel || !matDeptSel) return;
            deptSel.innerHTML = emptyOpt;
            matDeptSel.innerHTML = emptyOpt;
            if (!instId) {
                await masterLoadSemesterOptionsForSubject();
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/departments?institution_id=${encodeURIComponent(instId)}`, { headers: masterAuthHeaders() });
                const data = await res.json();
                const items = data.items || [];
                const opts = emptyOpt + items.map(d => `<option value="${d.id}">${d.name.replace(/</g, '')} (${d.stream})</option>`).join('');
                deptSel.innerHTML = opts;
                matDeptSel.innerHTML = opts;
                await masterLoadSemesterOptionsForSubject();
            } catch (e) {
                deptSel.innerHTML = emptyOpt;
                matDeptSel.innerHTML = emptyOpt;
            }
        }

        async function masterLoadSemesterOptionsForSubject() {
            const instId = document.getElementById('masterSubInstId')?.value || '';
            const semSel = document.getElementById('masterSubSemId');
            if (!semSel) return;
            semSel.innerHTML = '<option value="">No semester</option>';
            if (!instId) return;
            try {
                const res = await fetch(`${API_BASE}/master/semesters?institution_id=${encodeURIComponent(instId)}`, { headers: masterAuthHeaders() });
                const data = await res.json();
                (data.items || []).forEach(s => {
                    semSel.innerHTML += `<option value="${s.id}">${String(s.name).replace(/</g, '')}</option>`;
                });
            } catch (e) { /* no-op */ }
        }

        async function masterRefreshSubjects() {
            const list = document.getElementById('masterSubList');
            const status = document.getElementById('masterSubStatus');
            const deptId = document.getElementById('masterSubDeptId')?.value || '';
            if (!list) return;
            if (!deptId) {
                list.innerHTML = '<p class="text-gray-500">Select institution and department, then click List subjects.</p>';
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/subjects?department_id=${encodeURIComponent(deptId)}`, { headers: masterAuthHeaders() });
                const data = await res.json();
                if (!res.ok) {
                    list.innerHTML = `<p class="text-red-600">${data.message || 'Failed'}</p>`;
                    return;
                }
                const items = data.items || [];
                list.innerHTML = items.length ? items.map(s => `
                    <div class="flex justify-between items-center p-2 border rounded bg-gray-50">
                        <span>${s.code ? s.code + ' — ' : ''}${s.name} <span class="text-xs text-gray-500">(id ${s.id})</span></span>
                        <button type="button" onclick="masterDeleteSubject(${s.id})" class="text-xs px-2 py-1 text-red-600 border border-red-200 rounded hover:bg-red-50">Delete</button>
                    </div>
                `).join('') : '<p class="text-gray-500">No subjects.</p>';
                if (status) status.textContent = '';
                await masterLoadSubjectsForMaterials();
            } catch (e) {
                list.innerHTML = '<p class="text-red-600">Failed to load subjects</p>';
            }
        }

        async function masterCreateSubject() {
            const department_id = Number(document.getElementById('masterSubDeptId')?.value || 0);
            const semester_id = Number(document.getElementById('masterSubSemId')?.value || 0);
            const code = document.getElementById('masterSubCode')?.value?.trim() || '';
            const name = document.getElementById('masterSubName')?.value?.trim() || '';
            const credits = Number(document.getElementById('masterSubCredits')?.value || 3);
            const syllabus = document.getElementById('masterSubSyllabus')?.value?.trim() || '';
            const status = document.getElementById('masterSubStatus');
            if (!department_id || !name) {
                if (status) status.textContent = 'Department and subject name required';
                return;
            }
            try {
                const body = { department_id, name, code, credits, syllabus };
                if (semester_id > 0) body.semester_id = semester_id;
                const res = await fetch(`${API_BASE}/master/subjects`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify(body)
                });
                const data = await res.json();
                if (status) status.textContent = res.ok ? 'Subject added.' : (data.message || 'Failed');
                if (res.ok) {
                    document.getElementById('masterSubName').value = '';
                    document.getElementById('masterSubCode').value = '';
                    await masterRefreshSubjects();
                }
            } catch (e) {
                if (status) status.textContent = 'Request failed';
            }
        }

        async function masterDeleteSubject(id) {
            if (!confirm('Delete subject and its materials?')) return;
            try {
                await fetch(`${API_BASE}/master/subjects/${id}`, { method: 'DELETE', headers: masterAuthHeaders() });
                await masterRefreshSubjects();
            } catch (e) { /* no-op */ }
        }

        async function masterLoadSubjectsForMaterials() {
            const deptId = document.getElementById('masterMatDeptId')?.value || '';
            const subjSel = document.getElementById('masterMatSubjId');
            if (!subjSel) return;
            subjSel.innerHTML = '<option value="">Select subject</option>';
            if (!deptId) return;
            try {
                const res = await fetch(`${API_BASE}/master/subjects?department_id=${encodeURIComponent(deptId)}`, { headers: masterAuthHeaders() });
                const data = await res.json();
                (data.items || []).forEach(s => {
                    subjSel.innerHTML += `<option value="${s.id}">${String(s.name).replace(/</g, '')}</option>`;
                });
            } catch (e) { /* no-op */ }
        }

        async function masterRefreshMaterials() {
            const list = document.getElementById('masterMatList');
            const status = document.getElementById('masterMatStatus');
            const subjId = document.getElementById('masterMatSubjId')?.value || '';
            if (!list) return;
            if (!subjId) {
                list.innerHTML = '<p class="text-gray-500">Select department and subject.</p>';
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/materials?subject_id=${encodeURIComponent(subjId)}`, { headers: masterAuthHeaders() });
                const data = await res.json();
                if (!res.ok) {
                    list.innerHTML = `<p class="text-red-600">${data.message || 'Failed'}</p>`;
                    return;
                }
                const items = data.items || [];
                list.innerHTML = items.length ? items.map(m => `
                    <div class="flex justify-between items-start p-2 border rounded bg-gray-50 gap-2">
                        <div>
                            <p class="font-medium">${String(m.title).replace(/</g, '')} <span class="text-xs text-gray-500">(${m.material_type})</span></p>
                            <a href="${String(m.url).replace(/"/g, '')}" target="_blank" rel="noopener" class="text-xs text-blue-600 break-all">${String(m.url).replace(/</g, '')}</a>
                        </div>
                        <button type="button" onclick="masterDeleteMaterial(${m.id})" class="text-xs px-2 py-1 text-red-600 border border-red-200 rounded hover:bg-red-50 shrink-0">Delete</button>
                    </div>
                `).join('') : '<p class="text-gray-500">No materials.</p>';
                if (status) status.textContent = '';
            } catch (e) {
                list.innerHTML = '<p class="text-red-600">Failed to load materials</p>';
            }
        }

        async function masterCreateMaterial() {
            const subject_id = Number(document.getElementById('masterMatSubjId')?.value || 0);
            const title = document.getElementById('masterMatTitle')?.value?.trim() || '';
            const material_type = document.getElementById('masterMatType')?.value || 'link';
            const url = document.getElementById('masterMatUrl')?.value?.trim() || '';
            const description = document.getElementById('masterMatDesc')?.value?.trim() || '';
            const status = document.getElementById('masterMatStatus');
            if (!subject_id || !title || !url) {
                if (status) status.textContent = 'Subject, title, and URL required';
                return;
            }
            try {
                const res = await fetch(`${API_BASE}/master/materials`, {
                    method: 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify({ subject_id, title, material_type, url, description })
                });
                const data = await res.json();
                if (status) status.textContent = res.ok ? 'Material added.' : (data.message || 'Failed');
                if (res.ok) {
                    document.getElementById('masterMatTitle').value = '';
                    document.getElementById('masterMatUrl').value = '';
                    document.getElementById('masterMatDesc').value = '';
                    await masterRefreshMaterials();
                }
            } catch (e) {
                if (status) status.textContent = 'Request failed';
            }
        }

        async function masterDeleteMaterial(id) {
            if (!confirm('Delete this material?')) return;
            try {
                await fetch(`${API_BASE}/master/materials/${id}`, { method: 'DELETE', headers: masterAuthHeaders() });
                await masterRefreshMaterials();
            } catch (e) { /* no-op */ }
        }

        // Toggle sidebar on mobile
        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            sidebar.classList.toggle('active');
        }

        // Show section
        function showSection(sectionId) {
            // Hide all sections
            const sections = document.querySelectorAll('.content-section');
            sections.forEach(section => {
                section.classList.add('hidden');
                section.classList.remove('fade-in');
            });

            // Show selected section
            const selectedSection = document.getElementById(sectionId);
            if (selectedSection) {
                selectedSection.classList.remove('hidden');
                selectedSection.classList.add('fade-in');
            }

            // Update sidebar active state
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => {
                item.classList.remove('active');
            });
            
            // Find the link and mark it active
            const activeLink = document.querySelector(`a[onclick*="showSection('${sectionId}')"]`);
            if (activeLink) {
                activeLink.classList.add('active');
            }

            // Close sidebar on mobile after selection
            if (window.innerWidth <= 768) {
                const sidebar = document.querySelector('.sidebar');
                if (sidebar.classList.contains('active')) {
                    toggleSidebar();
                }
            }

            // Specific section loading
            if (sectionId === 'institutions') loadInstitutions();
            if (sectionId === 'departments') loadDepartments('engineering');
            if (sectionId === 'subjects') loadSubjects();
            if (sectionId === 'payments') loadAdminPayments();
            if (sectionId === 'faculty') loadFaculty();
            if (sectionId === 'analytics-advanced') loadInstitutionComparison();
        }

        async function loadAdminPayments() {
            try {
                const res = await fetch(`${API_BASE}/admin/payments`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                
                document.getElementById('totalCollectedText').textContent = `$${data.total_collected}`;
                document.getElementById('pendingPaymentsText').textContent = data.pending_count;
                
                const tbody = document.getElementById('paymentsTableBody');
                tbody.innerHTML = data.recent_payments.map(p => `
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${p.student_name}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold">$${p.amount}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <span class="px-2 py-1 rounded-full text-xs font-bold ${p.status === 'completed' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}">
                                ${p.status.toUpperCase()}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${new Date(p.created_at).toLocaleDateString()}</td>
                    </tr>
                `).join('') || '<tr><td colspan="4" class="p-4 text-center text-gray-500">No recent payments.</td></tr>';
            } catch (err) {
                console.error(err);
            }
        }

        async function loadInstitutions() {
            const list = document.getElementById('institutionsList');
            if (!list) return;
            try {
                const res = await fetch(`${API_BASE}/master/institutions`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                list.innerHTML = data.items.map(inst => `
                    <div class="stats-card card-shadow p-6 bg-white rounded-lg flex justify-between items-center">
                        <div>
                            <h3 class="text-xl font-bold text-blue-600">${inst.name}</h3>
                            <p class="text-gray-500 text-sm uppercase">${inst.type}</p>
                        </div>
                        <div class="text-3xl text-blue-200">
                            <i class="fas fa-university"></i>
                        </div>
                    </div>
                `).join('');
            } catch (err) {
                console.error(err);
                showToast('Failed to load institutions', 'error');
            }
        }

        async function loadDepartments(stream) {
            const list = document.getElementById('departmentsList');
            if (!list) return;
            try {
                const res = await fetch(`${API_BASE}/master/departments?stream=${stream}`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                list.innerHTML = data.items.map(dept => `
                    <div class="department-card card-shadow p-4 bg-white border-l-4 ${getStreamBorder(stream)}">
                        <h4 class="font-bold">${dept.name}</h4>
                        <p class="text-xs text-gray-500 uppercase">${stream}</p>
                    </div>
                `).join('');
            } catch (err) {
                console.error(err);
                showToast('Failed to load departments', 'error');
            }
        }

        function getStreamBorder(stream) {
            switch(stream) {
                case 'engineering': return 'border-blue-500';
                case 'medical': return 'border-red-500';
                case 'commerce': return 'border-green-500';
                default: return 'border-gray-500';
            }
        }

        async function loadSubjects() {
            const tbody = document.getElementById('subjectsTableBody');
            if (!tbody) return;
            try {
                const res = await fetch(`${API_BASE}/master/subjects`, {
                    headers: masterAuthHeaders()
                });
                const data = await res.json();
                tbody.innerHTML = data.items.map(sub => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-500">${sub.code || 'N/A'}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${sub.name}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${sub.department_name || 'N/A'}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <button class="text-blue-600 hover:text-blue-900 mr-3"><i class="fas fa-edit"></i></button>
                            <button class="text-red-600 hover:text-red-900"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `).join('');
            } catch (err) {
                console.error(err);
                showToast('Failed to load subjects', 'error');
            }
        }

        // Toggle chatbot
        function toggleChatbot() {
            const chatbotWindow = document.getElementById('chatbotWindow');
            chatbotWindow.style.display = chatbotWindow.style.display === 'flex' ? 'none' : 'flex';
        }

        // Send chatbot message
        function sendChatbotMessage() {
            const input = document.getElementById('chatbotInput');
            const message = input.value.trim();
            
            if (message) {
                const messagesContainer = document.getElementById('chatbotMessages');
                
                // Add user message
                const userMessage = document.createElement('div');
                userMessage.className = 'message user';
                userMessage.textContent = message;
                messagesContainer.appendChild(userMessage);
                
                // Clear input
                input.value = '';
                
                // Simulate bot response
                setTimeout(() => {
                    const botMessage = document.createElement('div');
                    botMessage.className = 'message bot';
                    
                    // Simple response logic
                    let response = "I'm here to help! Could you please provide more details?";
                    
                    if (message.toLowerCase().includes('student')) {
                        response = "I can help you with student-related queries. You can add, edit, or view student information in the Students section.";
                    } else if (message.toLowerCase().includes('department')) {
                        response = "For department management, please visit the Departments section where you can view all departments and their details.";
                    } else if (message.toLowerCase().includes('course')) {
                        response = "Course information is available in the Courses section. You can manage courses there.";
                    } else if (message.toLowerCase().includes('faculty')) {
                        response = "Faculty management is available in the Faculty section. You can add or view faculty members there.";
                    } else if (message.toLowerCase().includes('report')) {
                        response = "You can generate various reports in the Reports & Analytics section. Custom reports are also available.";
                    }
                    
                    botMessage.textContent = response;
                    messagesContainer.appendChild(botMessage);
                    
                    // Scroll to bottom
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }, 1000);
                
                // Scroll to bottom
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }
        }

        // Handle chatbot input enter key
        function handleChatbotInput(event) {
            if (event.key === 'Enter') {
                sendChatbotMessage();
            }
        }

        // Open modal
        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'flex';
        }

        // Close modal
        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Add department
        function addDepartment(event) {
            event.preventDefault();
            // Here you would normally send data to server
            alert('Department added successfully!');
            closeModal('addDepartmentModal');
        }

        // Load dashboard data
        async function loadDashboard() {
            try {
                const [dashboardRes, analyticsRes, insightsRes] = await Promise.all([
                    fetch(`${API_BASE}/dashboard`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                    }),
                    fetch(`${API_BASE}/analytics`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                    }),
                    fetch(`${API_BASE}/insights?limit=20`, {
                        headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                    })
                ]);

                const dashboard = await dashboardRes.json();
                const analytics = await analyticsRes.json();
                const insights = await insightsRes.json();

                updateDashboardStats(dashboard, analytics);
                updateSmartInsights(insights.items || [], analytics.at_risk || []);
                renderAnalyticsCharts(analytics);
                renderAnalyticsLists(analytics);
            } catch (err) {
                console.error(err);
            }
        }

        function updateDashboardStats(dashboard, analytics) {
            const totalStudentsEl = document.getElementById('totalStudentsStat');
            const totalStudentsSubtext = document.getElementById('totalStudentsSubtext');
            const avgAttendanceEl = document.getElementById('avgAttendanceStat');
            const avgAttendanceSubtext = document.getElementById('avgAttendanceSubtext');
            const atRiskEl = document.getElementById('atRiskStudentsStat');
            const atRiskSubtext = document.getElementById('atRiskStudentsSubtext');
            const topScoreEl = document.getElementById('topPredictedScoreStat');
            const topScoreSubtext = document.getElementById('topPredictedScoreSubtext');

            const topPerformer = (analytics.top_performers || [])[0];
            const atRiskCount = (analytics.at_risk || []).length;

            if (totalStudentsEl) totalStudentsEl.textContent = dashboard.total_students ?? 0;
            if (totalStudentsSubtext) totalStudentsSubtext.innerHTML = `<i class="fas fa-database"></i> ${dashboard.total_students ?? 0} active student records`;

            if (avgAttendanceEl) avgAttendanceEl.textContent = `${Math.round(analytics.avg_attendance ?? dashboard.avg_attendance ?? 0)}%`;
            if (avgAttendanceSubtext) {
                const avg = Number(analytics.avg_attendance ?? dashboard.avg_attendance ?? 0);
                avgAttendanceSubtext.innerHTML = `<i class="fas fa-chart-line"></i> ${avg >= 75 ? 'Healthy attendance trend' : avg >= 60 ? 'Needs attention' : 'Critical attendance zone'}`;
            }

            if (atRiskEl) atRiskEl.textContent = atRiskCount;
            if (atRiskSubtext) atRiskSubtext.innerHTML = `<i class="fas fa-triangle-exclamation"></i> ${atRiskCount > 0 ? 'Intervention recommended' : 'No urgent risks right now'}`;

            if (topScoreEl) topScoreEl.textContent = topPerformer ? Math.round(Number(topPerformer.predicted_marks || 0)) : 0;
            if (topScoreSubtext) topScoreSubtext.innerHTML = `<i class="fas fa-trophy"></i> ${topPerformer ? topPerformer.name : 'No performance data yet'}`;
        }

        function renderAnalyticsCharts(analytics) {
            if (!window.Chart) return;

            const trendCanvas = document.getElementById('attendanceTrendChart');
            const riskCanvas = document.getElementById('riskDistributionChart');

            const trendItems = Array.isArray(analytics.attendance_trend) && analytics.attendance_trend.length
                ? analytics.attendance_trend
                : (analytics.top_performers || []).map((item, index) => ({
                    day: item.name || `Student ${index + 1}`,
                    present_rate: Number(item.attendance || 0) / 100
                }));

            if (trendCanvas) {
                if (attendanceTrendChart) attendanceTrendChart.destroy();
                attendanceTrendChart = new Chart(trendCanvas, {
                    type: 'line',
                    data: {
                        labels: trendItems.map(item => item.day),
                        datasets: [{
                            label: 'Attendance %',
                            data: trendItems.map(item => Math.round(Number(item.present_rate || 0) * 100)),
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.15)',
                            tension: 0.35,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, max: 100 } }
                    }
                });
            }

            if (riskCanvas) {
                if (riskDistributionChart) riskDistributionChart.destroy();
                const distribution = analytics.distribution || {};
                const low = Number(distribution.attendance_low || 0);
                const medium = Number(distribution.attendance_medium || 0);
                const high = Number(distribution.attendance_high || 0);
                riskDistributionChart = new Chart(riskCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: ['Low', 'Medium', 'High'],
                        datasets: [{
                            data: [low, medium, high],
                            backgroundColor: ['#ef4444', '#f59e0b', '#10b981']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        }

        function renderAnalyticsLists(analytics) {
            const topList = document.getElementById('topPerformersList');
            const supportList = document.getElementById('supportStudentsList');
            const topPerformers = analytics.top_performers || [];
            const atRisk = analytics.at_risk || [];

            if (topList) {
                topList.innerHTML = topPerformers.length
                    ? topPerformers.slice(0, 5).map(student => `
                        <div class="p-3 rounded-lg bg-green-50 flex items-center justify-between">
                            <div>
                                <p class="font-medium text-gray-800">${student.name}</p>
                                <p class="text-sm text-gray-500">Attendance ${student.attendance}% • Study ${student.study_hours}h</p>
                            </div>
                            <span class="text-sm font-semibold text-green-600">${Math.round(Number(student.predicted_marks || 0))}</span>
                        </div>
                    `).join('')
                    : '<p class="text-sm text-gray-500">No top performer data yet.</p>';
            }

            if (supportList) {
                supportList.innerHTML = atRisk.length
                    ? atRisk.slice(0, 5).map(student => `
                        <div class="p-3 rounded-lg bg-red-50 flex items-center justify-between">
                            <div>
                                <p class="font-medium text-gray-800">${student.name}</p>
                                <p class="text-sm text-gray-500">Attendance ${student.attendance}% • Sleep ${student.sleep_hours}h</p>
                            </div>
                            <span class="text-sm font-semibold text-red-600">${Math.round(Number(student.predicted_marks || 0))}</span>
                        </div>
                    `).join('')
                    : '<p class="text-sm text-gray-500">No students currently flagged as at-risk.</p>';
            }
        }

        async function loadMonitoringStats() {
            try {
                const res = await fetch(`${API_BASE}/monitoring/stats`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                if (!res.ok) return;
                const stats = await res.json();

                const reqEl = document.getElementById('monitorRequests');
                const errEl = document.getElementById('monitorErrors');
                const activeEl = document.getElementById('monitorActiveUsers');
                const jobsEl = document.getElementById('monitorJobs');
                const updatedEl = document.getElementById('monitorUpdatedAt');
                const errorsListEl = document.getElementById('monitorErrorsList');

                if (reqEl) reqEl.textContent = stats.total_requests ?? 0;
                if (errEl) errEl.textContent = stats.error_requests ?? 0;
                if (activeEl) activeEl.textContent = stats.active_users_15m ?? 0;
                if (jobsEl) jobsEl.textContent = stats.jobs_running ?? 0;
                if (updatedEl) updatedEl.textContent = `Last updated: ${new Date().toLocaleTimeString()}`;
                if (errorsListEl) {
                    const items = Array.isArray(stats.last_errors) ? stats.last_errors : [];
                    if (!items.length) {
                        errorsListEl.innerHTML = `<div class="p-3 text-gray-500">No recent errors.</div>`;
                    } else {
                        errorsListEl.innerHTML = items.map(e => `
                            <div class="p-3 flex items-start justify-between gap-3">
                                <div>
                                    <p class="font-semibold text-gray-800">${e.method || 'API'} ${e.path || ''}</p>
                                    <p class="text-xs text-gray-500">${e.time ? new Date(e.time).toLocaleString() : ''}</p>
                                </div>
                                <span class="px-2 py-1 text-xs font-semibold rounded-full ${Number(e.status) >= 500 ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700'}">
                                    ${e.status ?? '-'}
                                </span>
                            </div>
                        `).join('');
                    }
                }
            } catch (err) {
                // Keep silent to avoid noisy dashboard; monitoring is best-effort UI.
                console.error(err);
            }
        }

        async function runButtonHealthCheck() {
            const token = localStorage.getItem('token');
            const grid = document.getElementById('healthCheckGrid');
            const updatedAt = document.getElementById('healthCheckUpdatedAt');
            const scoreEl = document.getElementById('healthScoreText');
            const criticalBannerEl = document.getElementById('healthCriticalBanner');
            if (!grid || !token) return;

            const checks = [
                { key: 'Dashboard', path: '/dashboard', critical: true },
                { key: 'Students List', path: '/students?paged=1&page=1&page_size=1', critical: true },
                { key: 'Analytics', path: '/analytics', critical: false },
                { key: 'Insights', path: '/insights', critical: false },
                { key: 'Monitoring', path: '/monitoring/stats', critical: true },
                { key: 'Alerts', path: '/alerts', critical: false },
                { key: 'Interventions', path: '/interventions?status=open&limit=1', critical: false }
            ];

            grid.innerHTML = checks.map(c => `
                <div id="health-${c.key.replace(/\s+/g, '-')}" class="p-3 rounded border border-gray-200 bg-gray-50">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm">${c.key}</span>
                        <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-700">CHECKING</span>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">${c.path}</p>
                </div>
            `).join('');

            const results = await Promise.all(checks.map(async (check) => {
                const id = `health-${check.key.replace(/\s+/g, '-')}`;
                const el = document.getElementById(id);
                const started = performance.now();
                try {
                    const res = await fetch(`${API_BASE}${check.path}`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const ms = Math.round(performance.now() - started);
                    const ok = res.ok;
                    if (el) {
                        el.innerHTML = `
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-sm">${check.key}</span>
                                <span class="px-2 py-1 text-xs rounded-full ${ok ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'}">
                                    ${ok ? 'HEALTHY' : 'FAILED'}
                                </span>
                            </div>
                            <p class="text-xs text-gray-500 mt-1">${check.path}</p>
                            <p class="text-xs mt-1 ${ok ? 'text-emerald-700' : 'text-red-700'}">
                                HTTP ${res.status} • ${ms}ms
                            </p>
                            ${check.critical ? '<p class="text-[11px] mt-1 text-red-600 font-semibold">CRITICAL</p>' : ''}
                        `;
                    }
                    return { ...check, ok };
                } catch (e) {
                    const ms = Math.round(performance.now() - started);
                    if (el) {
                        el.innerHTML = `
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-sm">${check.key}</span>
                                <span class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-700">FAILED</span>
                            </div>
                            <p class="text-xs text-gray-500 mt-1">${check.path}</p>
                            <p class="text-xs mt-1 text-red-700">Network/API error • ${ms}ms</p>
                            ${check.critical ? '<p class="text-[11px] mt-1 text-red-600 font-semibold">CRITICAL</p>' : ''}
                        `;
                    }
                    return { ...check, ok: false };
                }
            }));

            const healthyCount = results.filter(r => r.ok).length;
            const totalCount = results.length;
            const criticalFailed = results.some(r => r.critical && !r.ok);

            if (scoreEl) {
                scoreEl.textContent = `Overall: ${healthyCount}/${totalCount} APIs healthy`;
                scoreEl.className = `text-sm font-semibold ${healthyCount === totalCount ? 'text-emerald-700' : 'text-amber-700'}`;
            }
            if (criticalBannerEl) {
                criticalBannerEl.classList.toggle('hidden', !criticalFailed);
            }

            if (updatedAt) updatedAt.textContent = `Last checked: ${new Date().toLocaleTimeString()}`;
        }

        function openSearchPreset(query) {
            window.location.href = `search.html?q=${encodeURIComponent(query || '')}`;
        }

        function getAuditRelatedTarget(path) {
            const p = String(path || '').toLowerCase();
            if (p.includes('/faculty') || p.includes('/interventions')) return 'faculty.html';
            if (p.includes('/parent')) return 'parent.html';
            if (p.includes('/students') || p.includes('/assignments') || p.includes('/learning')) return 'search.html';
            return 'admin.html';
        }

        async function loadAuditSnapshot() {
            const wrap = document.getElementById('auditSnapshotList');
            if (!wrap) return;
            wrap.innerHTML = '<p>Loading audit records...</p>';
            try {
                const res = await fetch(`${API_BASE}/audit/logs?limit=6`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    wrap.innerHTML = `<p>${data.message || 'Failed to load audit records'}</p>`;
                    return;
                }
                const items = data.items || [];
                wrap.innerHTML = items.length ? items.map(x => `
                    <div class="p-2 rounded border bg-slate-50">
                        <div class="flex items-center justify-between gap-2">
                            <p class="font-medium text-xs">${x.method} ${x.path}</p>
                            <div class="flex items-center gap-1">
                                <span class="text-[11px] px-1.5 py-0.5 rounded ${Number(x.status_code || 0) >= 400 ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700'}">${x.status_code}</span>
                                <a href="${getAuditRelatedTarget(x.path)}" class="text-[11px] px-1.5 py-0.5 rounded border hover:bg-gray-100">Open</a>
                            </div>
                        </div>
                        <p class="text-[11px] text-gray-500 mt-1">${x.actor_role}#${x.actor_id || '-'} • ${x.created_at || ''}</p>
                    </div>
                `).join('') : '<p>No audit records.</p>';
            } catch (e) {
                wrap.innerHTML = '<p>Failed to load audit records.</p>';
            }
        }

        async function sendAdminQuickMessage() {
            const recipient_role = (document.getElementById('adminMsgRole')?.value || '').trim();
            const recipient_id = Number(document.getElementById('adminMsgRecipientId')?.value || 0);
            const body = (document.getElementById('adminMsgBody')?.value || '').trim();
            const statusEl = document.getElementById('adminMsgStatus');
            if (!recipient_role || !recipient_id || !body) {
                if (statusEl) statusEl.textContent = 'recipient role, id and message are required';
                return;
            }
            if (statusEl) statusEl.textContent = 'sending...';
            try {
                const res = await fetch(`${API_BASE}/messages/send`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ recipient_role, recipient_id, body })
                });
                const data = await res.json();
                if (!res.ok) {
                    if (statusEl) statusEl.textContent = data.message || 'failed to send';
                    return;
                }
                document.getElementById('adminMsgBody').value = '';
                if (statusEl) statusEl.textContent = 'sent';
                loadAdminRecentContacts();
                loadAdminMessageThread();
            } catch (e) {
                if (statusEl) statusEl.textContent = 'failed to send';
            }
        }

        async function loadAdminMessageThread() {
            const peer_role = (document.getElementById('adminMsgRole')?.value || '').trim();
            const peer_id = Number(document.getElementById('adminMsgRecipientId')?.value || 0);
            const threadEl = document.getElementById('adminMsgThread');
            if (!threadEl) return;
            if (!peer_role || peer_id <= 0) {
                threadEl.innerHTML = '<p class="text-gray-500">Enter peer role and ID.</p>';
                return;
            }
            threadEl.innerHTML = '<p class="text-gray-500">Loading thread...</p>';
            try {
                const res = await fetch(`${API_BASE}/messages/inbox?peer_role=${encodeURIComponent(peer_role)}&peer_id=${peer_id}&limit=30`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) {
                    threadEl.innerHTML = `<p class="text-red-600">${data.message || 'Failed to load thread'}</p>`;
                    return;
                }
                const me = JSON.parse(localStorage.getItem('user') || '{}');
                const items = (data.items || []).slice().reverse();
                adminThreadItems = items;
                const unreadCount = items.filter(m => String(m.recipient_role || '') === 'admin' && Number(m.recipient_id || 0) === Number(me.id || 0) && Number(m.is_read || 0) === 0).length;
                const unreadEl = document.getElementById('adminThreadUnread');
                if (unreadEl) unreadEl.textContent = `Unread in thread: ${unreadCount}`;
                renderAdminThread();
            } catch (e) {
                threadEl.innerHTML = '<p class="text-red-600">Failed to load thread.</p>';
            }
        }

        function renderAdminThread() {
            const threadEl = document.getElementById('adminMsgThread');
            if (!threadEl) return;
            const me = JSON.parse(localStorage.getItem('user') || '{}');
            const q = (document.getElementById('adminThreadSearch')?.value || '').trim().toLowerCase();
            const items = (adminThreadItems || []).filter(m => !q || String(m.body || '').toLowerCase().includes(q));
            threadEl.innerHTML = items.length ? items.map(m => {
                const isMine = Number(m.sender_id || 0) === Number(me.id || 0) && String(m.sender_role || '') === 'admin';
                const canMarkRead = !isMine && Number(m.is_read || 0) === 0 && String(m.recipient_role || '') === 'admin' && Number(m.recipient_id || 0) === Number(me.id || 0);
                return `
                    <div class="p-2 rounded border ${isMine ? 'bg-emerald-50 border-emerald-200' : 'bg-slate-50 border-slate-200'}">
                        <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
                            <p>${m.sender_role}#${m.sender_id} -> ${m.recipient_role}#${m.recipient_id}</p>
                            <p>${m.created_at || ''}</p>
                        </div>
                        <p class="text-sm mt-1">${m.body || ''}</p>
                        ${canMarkRead ? `<button onclick="markAdminThreadMessageRead(${m.id})" class="mt-1 text-[11px] px-2 py-1 rounded border hover:bg-white">Mark read</button>` : ''}
                    </div>
                `;
            }).join('') : '<p class="text-gray-500">No messages match this thread filter.</p>';
        }

        async function markAdminThreadMessageRead(messageId) {
            try {
                await fetch(`${API_BASE}/messages/mark-read`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token')}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id: messageId })
                });
            } catch (e) {
                // no-op
            }
            loadAdminMessageThread();
        }

        function applyAdminRecentContact(value) {
            if (!value) return;
            const [role, id] = String(value).split(':');
            if (!role || !id) return;
            const roleEl = document.getElementById('adminMsgRole');
            const idEl = document.getElementById('adminMsgRecipientId');
            if (roleEl) roleEl.value = role;
            if (idEl) idEl.value = id;
            loadAdminMessageThread();
        }

        async function loadAdminRecentContacts() {
            const selectEl = document.getElementById('adminRecentContacts');
            if (!selectEl) return;
            try {
                const res = await fetch(`${API_BASE}/messages/inbox?limit=120`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await res.json();
                if (!res.ok) return;
                const me = JSON.parse(localStorage.getItem('user') || '{}');
                const map = new Map();
                (data.items || []).forEach(m => {
                    const senderRole = String(m.sender_role || '');
                    const recipientRole = String(m.recipient_role || '');
                    const senderId = Number(m.sender_id || 0);
                    const recipientId = Number(m.recipient_id || 0);
                    const isSenderMe = senderRole === 'admin' && senderId === Number(me.id || 0);
                    const peerRole = isSenderMe ? recipientRole : senderRole;
                    const peerId = isSenderMe ? recipientId : senderId;
                    if (!peerRole || peerId <= 0) return;
                    const key = `${peerRole}:${peerId}`;
                    if (!map.has(key)) map.set(key, { role: peerRole, id: peerId, ts: String(m.created_at || '') });
                });
                const contacts = Array.from(map.values()).slice(0, 25);
                selectEl.innerHTML = '<option value="">Recent contacts</option>' + contacts.map(c => `<option value="${c.role}:${c.id}">${c.role}#${c.id}</option>`).join('');
            } catch (e) {
                // no-op
            }
        }

        function exportAdminThreadCsv() {
            const items = adminThreadItems || [];
            if (!items.length) return;
            const headers = ['id', 'sender_role', 'sender_id', 'recipient_role', 'recipient_id', 'body', 'is_read', 'created_at'];
            const escapeCsv = (v) => {
                const s = String(v ?? '');
                return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
            };
            const rows = [headers.join(','), ...items.map(x => headers.map(h => escapeCsv(x[h])).join(','))];
            const blob = new Blob([rows.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `admin_thread_${Date.now()}.csv`;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }

        // Update smart insights based on AI recommendation endpoint
        function updateSmartInsights(items, atRiskStudents) {
            const atRiskInsight = document.getElementById('atRiskInsight');
            const studyInsight = document.getElementById('studyInsight');
            const sleepInsight = document.getElementById('sleepInsight');

            const firstAtRisk = Array.isArray(atRiskStudents) ? atRiskStudents[0] : null;
            const flattened = Array.isArray(items) ? items.flatMap(item => item.recommendations || []) : [];
            const studyTip = flattened.find(text => text.toLowerCase().includes('increase study'));
            const sleepTip = flattened.find(text => text.toLowerCase().includes('sleep < 5')) || flattened.find(text => text.toLowerCase().includes('sleep'));

            if (atRiskInsight) {
                atRiskInsight.textContent = firstAtRisk
                    ? `${firstAtRisk.name}: low attendance -> risk of failure. Prioritize attendance recovery and mentoring.`
                    : 'No immediate failure-risk signal detected from attendance trends.';
            }

            if (studyInsight) {
                studyInsight.textContent = studyTip || 'Increase study by +2 hrs/day for weak students to improve predicted marks.';
            }

            if (sleepInsight) {
                sleepInsight.textContent = sleepTip || 'Sleep < 5 hrs -> performance drop. Encourage a healthier daily routine.';
            }
        }

        let allStudents = [];
        let studentsPage = 1;
        let studentsPageSize = 25;
        let studentsTotal = 0;
        let studentsTotalPages = 1;
        let studentsSearchTimer = null;

        function updateStudentsPaginationUI() {
            const showingEl = document.getElementById('studentsShowing');
            const pageInfoEl = document.getElementById('studentsPageInfo');
            const prevBtn = document.getElementById('studentsPrevBtn');
            const nextBtn = document.getElementById('studentsNextBtn');

            const start = studentsTotal === 0 ? 0 : (studentsPage - 1) * studentsPageSize + 1;
            const end = Math.min(studentsPage * studentsPageSize, studentsTotal);

            if (showingEl) showingEl.textContent = `Showing ${start}–${end} of ${studentsTotal}`;
            if (pageInfoEl) pageInfoEl.textContent = `Page ${studentsPage} of ${studentsTotalPages}`;
            if (prevBtn) prevBtn.disabled = studentsPage <= 1;
            if (nextBtn) nextBtn.disabled = studentsPage >= studentsTotalPages;
        }

        function getStudentsQueryParams() {
            const search = document.getElementById('searchStudent')?.value || '';
            const attendance = document.getElementById('filterAttendance')?.value || 'all';
            const risk = document.getElementById('filterRisk')?.value || 'all';
            const performance = document.getElementById('filterPerformance')?.value || 'all';

            const params = new URLSearchParams();
            params.set('paged', '1');
            params.set('page', String(studentsPage));
            params.set('page_size', String(studentsPageSize));
            if (search) params.set('search', search);
            if (attendance && attendance !== 'all') params.set('attendance', attendance);
            if (risk && risk !== 'all') params.set('risk', risk);
            if (performance && performance !== 'all') params.set('performance', performance);
            return params;
        }

        // Load students (server-side pagination)
        async function loadStudents(page = 1) {
            try {
                studentsPage = Math.max(1, parseInt(page, 10) || 1);
                const response = await fetch(`${API_BASE}/students?${getStudentsQueryParams().toString()}`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                const data = await response.json();

                allStudents = data.items || [];
                studentsTotal = data.total || 0;
                studentsTotalPages = data.total_pages || 1;

                renderStudents(allStudents);
                updateStudentsPaginationUI();
                
                // Add event listeners once
                const searchEl = document.getElementById('searchStudent');
                const filterAttendance = document.getElementById('filterAttendance');
                const filterRisk = document.getElementById('filterRisk');
                const filterPerformance = document.getElementById('filterPerformance');
                const pageSizeEl = document.getElementById('studentsPageSize');
                const prevBtn = document.getElementById('studentsPrevBtn');
                const nextBtn = document.getElementById('studentsNextBtn');

                if (searchEl && !searchEl.dataset.boundPaged) {
                    searchEl.dataset.boundPaged = '1';
                    searchEl.addEventListener('input', () => {
                        clearTimeout(studentsSearchTimer);
                        studentsSearchTimer = setTimeout(() => loadStudents(1), 250);
                    });
                }
                if (filterAttendance && !filterAttendance.dataset.boundPaged) {
                    filterAttendance.dataset.boundPaged = '1';
                    filterAttendance.addEventListener('change', () => loadStudents(1));
                }
                if (filterRisk && !filterRisk.dataset.boundPaged) {
                    filterRisk.dataset.boundPaged = '1';
                    filterRisk.addEventListener('change', () => loadStudents(1));
                }
                if (filterPerformance && !filterPerformance.dataset.boundPaged) {
                    filterPerformance.dataset.boundPaged = '1';
                    filterPerformance.addEventListener('change', () => loadStudents(1));
                }
                if (pageSizeEl && !pageSizeEl.dataset.boundPaged) {
                    pageSizeEl.dataset.boundPaged = '1';
                    pageSizeEl.addEventListener('change', () => {
                        studentsPageSize = parseInt(pageSizeEl.value, 10) || 25;
                        loadStudents(1);
                    });
                }
                if (prevBtn && !prevBtn.dataset.boundPaged) {
                    prevBtn.dataset.boundPaged = '1';
                    prevBtn.addEventListener('click', () => loadStudents(studentsPage - 1));
                }
                if (nextBtn && !nextBtn.dataset.boundPaged) {
                    nextBtn.dataset.boundPaged = '1';
                    nextBtn.addEventListener('click', () => loadStudents(studentsPage + 1));
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Render students to table
        function renderStudents(students) {
            const tbody = document.querySelector('#students tbody');
            if (tbody) {
                tbody.innerHTML = students.map(student => {
                    const riskLevel = getRiskLevel(student);
                    const predictedMarks = getPredictedMarks(student);
                    return `
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <img class="h-10 w-10 rounded-full" src="https://picsum.photos/seed/student${student.id}/50/50" alt="">
                                    <div class="ml-4">
                                        <a class="text-sm font-medium text-gray-900 hover:underline" href="student_profile.html?id=${student.id}">
                                            ${student.name}
                                        </a>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">#${student.id}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${student.department_name || 'General'}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${student.attendance >= 75 ? 'bg-green-100 text-green-800' : student.attendance >= 60 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'}">
                                    ${student.attendance}%
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${student.study_hours}h</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${student.sleep_hours}h</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold ${predictedMarks >= 75 ? 'text-green-600' : predictedMarks >= 60 ? 'text-yellow-600' : 'text-red-600'}">${predictedMarks}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${riskLevel === 'safe' ? 'bg-green-100 text-green-800' : riskLevel === 'warning' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'}">
                                    ${formatRiskLabel(riskLevel)}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button onclick="openEditStudentModal(${student.id}, '${student.name}', ${student.attendance}, ${student.study_hours}, ${student.sleep_hours}, ${student.department_id || 'null'}, ${student.semester_id || 'null'}, '${student.mobile || ''}')" class="text-blue-600 hover:text-blue-900 mr-3">Edit</button>
                                <button onclick="deleteStudent(${student.id})" class="text-red-600 hover:text-red-900">Delete</button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }
        }

        function getPredictedMarks(student) {
            if (student.predicted_marks !== undefined && student.predicted_marks !== null) {
                return Math.round(Number(student.predicted_marks));
            }
            const attendance = Number(student.attendance || 0);
            const study = Number(student.study_hours || 0);
            const sleep = Number(student.sleep_hours || 0);
            const derived = (attendance * 0.55) + (study * 8) + (sleep * 1.5) - (sleep < 5 ? 8 : 0);
            return Math.max(0, Math.min(100, Math.round(derived)));
        }

        // Get risk level for a student
        function getRiskLevel(student) {
            if (student.risk_level) return String(student.risk_level);
            if (student.attendance < 60 || student.study_hours < 2 || student.sleep_hours < 5) return 'atrisk';
            if (student.attendance < 75) return 'warning';
            return 'safe';
        }

        function formatRiskLabel(riskLevel) {
            if (riskLevel === 'atrisk') return 'AT RISK';
            if (riskLevel === 'warning') return 'WARNING';
            return 'SAFE';
        }

        // Reset all filters
        function resetFilters() {
            if (document.getElementById('searchStudent')) document.getElementById('searchStudent').value = '';
            if (document.getElementById('filterAttendance')) document.getElementById('filterAttendance').value = 'all';
            if (document.getElementById('filterRisk')) document.getElementById('filterRisk').value = 'all';
            if (document.getElementById('filterPerformance')) document.getElementById('filterPerformance').value = 'all';
            loadStudents(1);
        }

        // Drill-down analytics helpers (open Students with filters)
        function drillDownAtRisk() {
            showSection('students');
            if (document.getElementById('filterRisk')) document.getElementById('filterRisk').value = 'atrisk';
            loadStudents(1);
        }

        function drillDownLowStudy() {
            showSection('students');
            if (document.getElementById('filterPerformance')) document.getElementById('filterPerformance').value = 'weak';
            loadStudents(1);
        }

        function drillDownLowSleep() {
            showSection('students');
            if (document.getElementById('filterRisk')) document.getElementById('filterRisk').value = 'warning';
            loadStudents(1);
        }

        async function downloadStudentsReport(format) {
            try {
                const search = document.getElementById('searchStudent')?.value || '';
                const attendance = document.getElementById('filterAttendance')?.value || 'all';
                const risk = document.getElementById('filterRisk')?.value || 'all';
                const performance = document.getElementById('filterPerformance')?.value || 'all';

                const params = new URLSearchParams();
                if (search) params.set('search', search);
                if (attendance && attendance !== 'all') params.set('attendance', attendance);
                if (risk && risk !== 'all') params.set('risk', risk);
                if (performance && performance !== 'all') params.set('performance', performance);

                const endpoint = `${API_BASE}/reports/students.${format}?${params.toString()}`;
                const res = await fetch(endpoint, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    showToast(err.message || 'Export failed!', 'error');
                    return;
                }

                const blob = await res.blob();
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `students_${new Date().toISOString().split('T')[0]}.${format}`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
                showToast('Report downloaded!', 'success');
            } catch (e) {
                showToast('Export failed!', 'error');
            }
        }

        function generateCustomReport() {
            const format = String(document.getElementById('reportFormat')?.value || 'PDF').toLowerCase();
            const normalized = format === 'excel' ? 'xlsx' : format;
            downloadStudentsReport(normalized);
        }

        // Student Management
        function openAddStudentModal() {
            document.getElementById('studentModalTitle').textContent = 'Add Student';
            document.getElementById('studentId').value = '';
            document.getElementById('studentName').value = '';
            document.getElementById('studentMobile').value = '';
            document.getElementById('studentAtt').value = '0';
            document.getElementById('studentStudy').value = '0';
            document.getElementById('studentSleep').value = '8';
            loadDeptsAndSems();
            openModal('studentModal');
        }

        async function openEditStudentModal(id, name, attendance, study, sleep, deptId, semId, mobile) {
            document.getElementById('studentModalTitle').textContent = 'Edit Student';
            document.getElementById('studentId').value = id;
            document.getElementById('studentName').value = name;
            document.getElementById('studentMobile').value = mobile || '';
            document.getElementById('studentAtt').value = attendance;
            document.getElementById('studentStudy').value = study;
            document.getElementById('studentSleep').value = sleep;
            await loadDeptsAndSems();
            document.getElementById('studentDept').value = deptId || '';
            document.getElementById('studentSem').value = semId || '';
            openModal('studentModal');
        }

        async function loadDeptsAndSems() {
            try {
                const [dRes, sRes] = await Promise.all([
                    fetch(`${API_BASE}/master/departments`, { headers: masterAuthHeaders() }),
                    fetch(`${API_BASE}/master/semesters`, { headers: masterAuthHeaders() })
                ]);
                const depts = await dRes.json();
                const sems = await sRes.json();
                
                document.getElementById('studentDept').innerHTML = '<option value="">Select Department</option>' + 
                    depts.items.map(d => `<option value="${d.id}">${d.name} (${d.stream})</option>`).join('');
                document.getElementById('studentSem').innerHTML = '<option value="">Select Semester</option>' + 
                    sems.items.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
            } catch (err) { console.error(err); }
        }

        async function loadFaculty() {
            const list = document.getElementById('facultyList');
            if (!list) return;
            try {
                const res = await fetch(`${API_BASE}/faculty`, { headers: masterAuthHeaders() });
                const data = await res.json();
                list.innerHTML = data.items.map(f => `
                    <div class="bg-white p-4 rounded-lg shadow-sm border flex items-center space-x-4">
                        <img src="https://picsum.photos/seed/faculty${f.id}/60/60" class="w-12 h-12 rounded-full">
                        <div class="flex-1">
                            <h4 class="font-bold">${f.name}</h4>
                            <p class="text-xs text-gray-500">${f.department_name || 'N/A'}</p>
                        </div>
                        <div class="flex space-x-2">
                            <button onclick="openEditFacultyModal(${f.id}, '${f.name}', '${f.email}', ${f.department_id})" class="text-blue-600"><i class="fas fa-edit"></i></button>
                            <button class="text-red-600"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>
                `).join('');
            } catch (err) { console.error(err); }
        }

        async function saveFaculty(event) {
            event.preventDefault();
            const id = document.getElementById('facultyId').value;
            const payload = {
                name: document.getElementById('facultyName').value,
                email: document.getElementById('facultyEmail').value,
                department_id: document.getElementById('facultyDept').value
            };
            try {
                const url = id ? `${API_BASE}/faculty/${id}` : `${API_BASE}/faculty`;
                const res = await fetch(url, {
                    method: id ? 'PUT' : 'POST',
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify(payload)
                });
                if (res.ok) {
                    showToast('Faculty saved!', 'success');
                    closeModal('facultyModal');
                    loadFaculty();
                }
            } catch (err) { showToast('Save failed', 'error'); }
        }

        async function openAddFacultyModal() {
            document.getElementById('facultyModalTitle').textContent = 'Add Faculty';
            document.getElementById('facultyId').value = '';
            document.getElementById('facultyName').value = '';
            document.getElementById('facultyEmail').value = '';
            await loadFacultyDepts();
            openModal('facultyModal');
        }

        async function loadFacultyDepts() {
            const select = document.getElementById('facultyDept');
            const res = await fetch(`${API_BASE}/master/departments`, { headers: masterAuthHeaders() });
            const data = await res.json();
            select.innerHTML = data.items.map(d => `<option value="${d.id}">${d.name}</option>`).join('');
        }
            event.preventDefault();
            const id = document.getElementById('studentId').value;
            const payload = {
                name: document.getElementById('studentName').value,
                mobile: document.getElementById('studentMobile').value,
                department_id: parseInt(document.getElementById('studentDept').value),
                semester_id: parseInt(document.getElementById('studentSem').value),
                attendance: parseFloat(document.getElementById('studentAtt').value),
                study_hours: parseFloat(document.getElementById('studentStudy').value),
                sleep_hours: parseFloat(document.getElementById('studentSleep').value)
            };

            try {
                const url = id ? `${API_BASE}/students/${id}` : `${API_BASE}/students`;
                const method = id ? 'PUT' : 'POST';
                const res = await fetch(url, {
                    method,
                    headers: masterAuthHeadersJson(),
                    body: JSON.stringify(payload)
                });
                if (res.ok) {
                    showToast(id ? 'Student updated!' : 'Student added!', 'success');
                    closeModal('studentModal');
                    loadStudents(studentsPage);
                } else {
                    showToast('Save failed', 'error');
                }
            } catch (err) { showToast('Save failed', 'error'); }
        }

        // Delete student
        async function deleteStudent(id) {
            if (!confirm('Delete this student?')) return;
            
            try {
                await fetch(`${API_BASE}/students/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                loadStudents(studentsPage);
                showToast('Student deleted!', 'success');
            } catch (err) {
                showToast('Delete failed!', 'error');
            }
        }

