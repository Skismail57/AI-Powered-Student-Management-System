<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System - Admin Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-blue: #1e40af;
            --light-blue: #3b82f6;
            --very-light-blue: #dbeafe;
            --dark-blue: #1e3a8a;
            --white: #ffffff;
            --gray-light: #f3f4f6;
            --gray-medium: #9ca3af;
            --gray-dark: #374151;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--gray-light);
            color: var(--gray-dark);
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .gradient-bg {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--light-blue) 100%);
        }

        .card-shadow {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
        }

        .card-shadow:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            transform: translateY(-2px);
        }

        .sidebar-item {
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }

        .sidebar-item:hover {
            background-color: rgba(59, 130, 246, 0.1);
            border-left-color: var(--light-blue);
        }

        .sidebar-item.active {
            background-color: rgba(59, 130, 246, 0.15);
            border-left-color: var(--light-blue);
            color: var(--primary-blue);
        }

        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .slide-up {
            animation: slideUp 0.5s ease-out;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .chatbot-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }

        .chatbot-bubble {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }

        .chatbot-bubble:hover {
            transform: scale(1.1);
        }

        .chatbot-window {
            position: absolute;
            bottom: 80px;
            right: 0;
            width: 350px;
            height: 500px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            display: none;
            flex-direction: column;
            overflow: hidden;
        }

        .chatbot-header {
            background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
            color: white;
            padding: 15px;
            font-weight: 600;
        }

        .chatbot-messages {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            background: #f9fafb;
        }

        .chatbot-input {
            padding: 15px;
            border-top: 1px solid #e5e7eb;
            display: flex;
        }

        .chatbot-input input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #d1d5db;
            border-radius: 20px;
            outline: none;
        }

        .chatbot-input button {
            margin-left: 10px;
            padding: 8px 15px;
            background: var(--light-blue);
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .chatbot-input button:hover {
            background: var(--primary-blue);
        }

        .message {
            margin-bottom: 10px;
            padding: 10px 15px;
            border-radius: 18px;
            max-width: 80%;
        }

        .message.bot {
            background: #e5e7eb;
            align-self: flex-start;
        }

        .message.user {
            background: var(--light-blue);
            color: white;
            align-self: flex-end;
            margin-left: auto;
        }

        .stats-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(59, 130, 246, 0.05));
            border-radius: 0 0 0 100px;
        }

        .department-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .department-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: var(--light-blue);
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .department-card:hover::after {
            transform: scaleY(1);
        }

        .department-card:hover {
            transform: translateX(5px);
        }

        .table-hover tbody tr:hover {
            background-color: rgba(59, 130, 246, 0.05);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-blue), var(--light-blue));
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(59, 130, 246, 0.3);
        }

        .form-input {
            width: 100%;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 5px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-input:focus {
            border-color: var(--light-blue);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            border-radius: 10px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            animation: slideUp 0.3s ease-out;
        }

        .close-modal {
            float: right;
            font-size: 24px;
            cursor: pointer;
            color: #9ca3af;
        }

        .close-modal:hover {
            color: #374151;
        }

        .notification-panel {
            position: fixed;
            top: 88px;
            right: 20px;
            width: 360px;
            max-height: 70vh;
            overflow-y: auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
            border: 1px solid #e5e7eb;
            z-index: 1500;
        }

        .theme-toggle-btn,
        .notification-toggle-btn {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            padding: 10px 14px;
            border-radius: 10px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .theme-toggle-btn:hover,
        .notification-toggle-btn:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .notification-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 18px;
            height: 18px;
            border-radius: 999px;
            background: #ef4444;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
        }

        body.theme-dark {
            background-color: #0f172a;
            color: #e5e7eb;
        }

        body.theme-dark .bg-white,
        body.theme-dark .stats-card,
        body.theme-dark .department-card,
        body.theme-dark .modal-content,
        body.theme-dark .chatbot-window,
        body.theme-dark .notification-panel,
        body.theme-dark .sidebar {
            background: #111827 !important;
            color: #e5e7eb !important;
            border-color: #374151 !important;
        }

        body.theme-dark .chatbot-messages,
        body.theme-dark .bg-gray-50,
        body.theme-dark .bg-blue-50,
        body.theme-dark .bg-green-50,
        body.theme-dark .bg-yellow-50,
        body.theme-dark .bg-purple-50,
        body.theme-dark .bg-red-50,
        body.theme-dark .bg-slate-50,
        body.theme-dark .bg-gray-100 {
            background: #1f2937 !important;
        }

        body.theme-dark .text-gray-800,
        body.theme-dark .text-gray-700,
        body.theme-dark .text-gray-600,
        body.theme-dark .text-gray-500,
        body.theme-dark .text-gray-900 {
            color: #d1d5db !important;
        }

        body.theme-dark .form-input,
        body.theme-dark input,
        body.theme-dark select,
        body.theme-dark textarea {
            background: #0f172a !important;
            color: #e5e7eb !important;
            border-color: #475569 !important;
        }

        body.theme-dark .table-hover tbody tr:hover {
            background-color: rgba(96, 165, 250, 0.12);
        }

        body.theme-dark .sidebar-item:hover,
        body.theme-dark .sidebar-item.active {
            background-color: rgba(96, 165, 250, 0.15);
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                position: fixed;
                z-index: 100;
                height: 100%;
                transition: transform 0.3s ease;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .menu-toggle {
                display: block;
            }
        }

        @media (min-width: 769px) {
            .menu-toggle {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="gradient-bg text-white shadow-lg">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <button class="menu-toggle text-white" onclick="toggleSidebar()">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
                <div class="flex items-center space-x-3">
                    <i class="fas fa-graduation-cap text-3xl"></i>
                    <h1 class="text-2xl font-bold">Student Management System</h1>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <a href="search.html" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-3 py-2 rounded-lg transition text-sm">Search</a>
                <a href="messages.html" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-3 py-2 rounded-lg transition text-sm">Messages</a>
                <a href="audit.html" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-3 py-2 rounded-lg transition text-sm">Audit</a>
                <button id="themeToggleBtn" class="theme-toggle-btn" title="Toggle theme">
                    <i class="fas fa-moon mr-2"></i><span id="themeToggleText">Dark</span>
                </button>
                <div class="relative">
                    <button id="notificationToggleBtn" class="notification-toggle-btn" title="Notifications">
                        <i class="fas fa-bell"></i>
                    </button>
                    <span id="notificationCountBadge" class="notification-badge hidden">0</span>
                </div>
                <div class="text-right">
                    <p class="font-semibold" id="adminName">Admin User</p>
                    <p class="text-sm opacity-90">Administrator</p>
                </div>
                <img src="https://picsum.photos/seed/admin/50/50" alt="Admin" class="w-12 h-12 rounded-full border-2 border-white">
                <button id="logoutBtn" class="bg-white bg-opacity-20 hover:bg-opacity-30 px-4 py-2 rounded-lg transition">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </header>

    <div id="notificationPanel" class="notification-panel hidden">
        <div class="p-4 border-b border-gray-200 flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Notifications</h3>
                <p class="text-sm text-gray-500">System alerts and smart reminders</p>
            </div>
            <button id="clearNotificationsBtn" class="text-sm text-blue-600 hover:text-blue-800">Clear</button>
        </div>
        <div id="notificationList" class="divide-y divide-gray-100">
            <div class="p-4 text-sm text-gray-500">No notifications yet.</div>
        </div>
    </div>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="sidebar w-64 bg-white shadow-lg min-h-screen">
            <nav class="p-4">
                <ul class="space-y-2">
                    <li>
                        <a href="#" onclick="showSection('dashboard')" class="sidebar-item active flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-tachometer-alt w-5"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('institutions')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-university w-5"></i>
                            <span>Colleges</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('departments')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-building w-5"></i>
                            <span>Departments</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('subjects')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-book w-5"></i>
                            <span>Subjects</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('faculty')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-chalkboard-teacher w-5"></i>
                            <span>Faculty</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('students')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-user-graduate w-5"></i>
                            <span>Students</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('payments')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-money-bill-wave w-5"></i>
                            <span>Payments</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('reports')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-chart-bar w-5"></i>
                            <span>Reports</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('analytics-advanced')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-chart-area w-5"></i>
                            <span>Advanced Analytics</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('cloud-admin')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-cloud w-5"></i>
                            <span>Cloud & Security</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" onclick="showSection('settings')" class="sidebar-item flex items-center space-x-3 p-3 rounded-lg">
                            <i class="fas fa-cog w-5"></i>
                            <span>Settings</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-6">
            <!-- Dashboard Section -->
            <section id="dashboard" class="content-section fade-in">
                <h2 class="text-3xl font-bold mb-6 text-gray-800">Dashboard Overview</h2>
                
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Total Students</p>
                                <p id="totalStudentsStat" class="text-3xl font-bold text-blue-600">0</p>
                                <p id="totalStudentsSubtext" class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-database"></i> Live system count
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-user-graduate"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Avg Attendance</p>
                                <p id="avgAttendanceStat" class="text-3xl font-bold text-blue-600">0%</p>
                                <p id="avgAttendanceSubtext" class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-chart-line"></i> Attendance health
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Active Faculty</p>
                                <p id="activeFacultyStat" class="text-3xl font-bold text-blue-600">0</p>
                                <p class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-chalkboard-teacher"></i> Teaching staff
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-user-tie"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">System Health</p>
                                <p class="text-3xl font-bold text-green-600">99.9%</p>
                                <p class="text-sm text-blue-500 mt-1">
                                    <i class="fas fa-shield-alt"></i> Secure & Online
                                </p>
                            </div>
                            <div class="text-4xl text-green-100">
                                <i class="fas fa-server"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                    <!-- Attendance Trend -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border">
                        <h3 class="text-xl font-bold mb-6 flex items-center">
                            <i class="fas fa-chart-area mr-3 text-blue-500"></i> Attendance Trend
                        </h3>
                        <div class="h-[300px]">
                            <canvas id="attendanceTrendChart"></canvas>
                        </div>
                    </div>
                    
                    <!-- Risk Distribution -->
                    <div class="bg-white p-6 rounded-xl shadow-sm border">
                        <h3 class="text-xl font-bold mb-6 flex items-center">
                            <i class="fas fa-chart-pie mr-3 text-rose-500"></i> Student Risk Distribution
                        </h3>
                        <div class="h-[300px]">
                            <canvas id="riskDistributionChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- System Monitoring & Real-time Logs -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-sm border">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-xl font-bold flex items-center">
                                <i class="fas fa-terminal mr-3 text-gray-700"></i> Real-time System Monitoring
                            </h3>
                            <div class="flex gap-2">
                                <button id="runHealthCheckBtn" class="text-xs px-3 py-1.5 bg-blue-50 text-blue-600 rounded-lg font-bold hover:bg-blue-100 transition">
                                    Run Health Check
                                </button>
                                <button id="toggleErrorsBtn" class="text-xs px-3 py-1.5 bg-rose-50 text-rose-600 rounded-lg font-bold hover:bg-rose-100 transition">
                                    View last errors
                                </button>
                            </div>
                        </div>
                        
                        <div id="monitorStatsGrid" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                            <!-- Dynamic stats -->
                        </div>

                        <div id="monitorErrorsWrap" class="hidden mt-6 p-4 bg-gray-900 rounded-lg font-mono text-xs text-rose-400 overflow-x-auto">
                            <div class="flex justify-between items-center mb-2 border-b border-gray-800 pb-2">
                                <span>LATEST SYSTEM EXCEPTIONS</span>
                                <button id="clearErrorsBtn" class="text-gray-500 hover:text-white">CLEAR</button>
                            </div>
                            <div id="monitorErrorsList" class="space-y-1">
                                <!-- Dynamic logs -->
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-sm border">
                        <h3 class="text-xl font-bold mb-6 flex items-center">
                            <i class="fas fa-history mr-3 text-indigo-500"></i> Security Audit Snapshot
                        </h3>
                        <div id="auditSnapshotList" class="space-y-4">
                            <!-- Dynamic audit logs -->
                        </div>
                        <button onclick="showSection('cloud-admin')" class="w-full mt-6 py-3 bg-gray-50 text-gray-600 rounded-lg text-sm font-bold hover:bg-gray-100 transition">
                            View Full Audit Log
                        </button>
                    </div>
                </div>
            </section>

            <!-- Institutions Section -->
            <section id="institutions" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Colleges / Institutions</h2>
                    <button class="btn-primary" onclick="openModal('addInstitutionModal')">
                        <i class="fas fa-plus mr-2"></i>Add College
                    </button>
                </div>
                <div id="institutionsList" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Dynamic institutions here -->
                </div>
            </section>

            <!-- Departments Section -->
            <section id="departments" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Departments</h2>
                    <button class="btn-primary" onclick="openModal('addDepartmentModal')">
                        <i class="fas fa-plus mr-2"></i>Add Department
                    </button>
                </div>
                <div class="mb-4 flex gap-2">
                    <button onclick="loadDepartments('engineering')" class="px-3 py-1 bg-blue-100 text-blue-700 rounded">Engineering</button>
                    <button onclick="loadDepartments('medical')" class="px-3 py-1 bg-red-100 text-red-700 rounded">Medical</button>
                    <button onclick="loadDepartments('commerce')" class="px-3 py-1 bg-green-100 text-green-700 rounded">Commerce</button>
                </div>
                <div id="departmentsList" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Dynamic departments here -->
                </div>
            </section>

            <!-- Subjects Section -->
            <section id="subjects" class="content-section hidden fade-in">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Subjects</h2>
                    <button class="btn-primary" onclick="openModal('addSubjectModal')">
                        <i class="fas fa-plus mr-2"></i>Add Subject
                    </button>
                </div>
                <div id="subjectsList" class="bg-white rounded-lg shadow overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Department</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="subjectsTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- Dynamic subjects here -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Payments Section -->
            <section id="payments" class="content-section hidden fade-in">
                <h2 class="text-3xl font-bold mb-6 text-gray-800">Fee & Payments Management</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-green-500">
                        <p class="text-gray-500 text-sm uppercase font-bold">Total Collected</p>
                        <p id="totalCollectedText" class="text-3xl font-bold text-green-600">$0.00</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-yellow-500">
                        <p class="text-gray-500 text-sm uppercase font-bold">Pending Requests</p>
                        <p id="pendingPaymentsText" class="text-3xl font-bold text-yellow-600">0</p>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-500">
                        <p class="text-gray-500 text-sm uppercase font-bold">Payment Success Rate</p>
                        <p class="text-3xl font-bold text-blue-600">94%</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                            </tr>
                        </thead>
                        <tbody id="paymentsTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- Dynamic payments here -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Dashboard Section -->
            <section id="dashboard" class="content-section fade-in">
                <h2 class="text-3xl font-bold mb-6 text-gray-800">Dashboard Overview</h2>
                
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Total Students</p>
                                <p id="totalStudentsStat" class="text-3xl font-bold text-blue-600">0</p>
                                <p id="totalStudentsSubtext" class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-database"></i> Live system count
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-user-graduate"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Avg Attendance</p>
                                <p id="avgAttendanceStat" class="text-3xl font-bold text-blue-600">0%</p>
                                <p id="avgAttendanceSubtext" class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-chart-line"></i> Attendance health
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">At-Risk Students</p>
                                <p id="atRiskStudentsStat" class="text-3xl font-bold text-blue-600">0</p>
                                <p id="atRiskStudentsSubtext" class="text-sm text-red-500 mt-1">
                                    <i class="fas fa-triangle-exclamation"></i> Need support
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-heart-pulse"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stats-card card-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500 text-sm">Top Predicted Score</p>
                                <p id="topPredictedScoreStat" class="text-3xl font-bold text-blue-600">0</p>
                                <p id="topPredictedScoreSubtext" class="text-sm text-green-500 mt-1">
                                    <i class="fas fa-trophy"></i> Best performer
                                </p>
                            </div>
                            <div class="text-4xl text-blue-200">
                                <i class="fas fa-trophy"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Smart Insights (AI Recommendations) -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-blue-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-brain text-blue-500 mr-2"></i> Smart Insights & Recommendations
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="smartInsights">
                        <div class="p-4 bg-yellow-50 rounded-lg border border-yellow-200 cursor-pointer hover:bg-yellow-100 transition" onclick="drillDownAtRisk()">
                            <div class="flex items-center mb-2">
                                <i class="fas fa-exclamation-triangle text-yellow-500 mr-2"></i>
                                <span class="font-semibold text-yellow-800">At-Risk Students</span>
                            </div>
                            <p class="text-yellow-700 text-sm" id="atRiskInsight">
                                0 students have attendance below 60% - immediate attention needed.
                            </p>
                        </div>
                        <div class="p-4 bg-blue-50 rounded-lg border border-blue-200 cursor-pointer hover:bg-blue-100 transition" onclick="drillDownLowStudy()">
                            <div class="flex items-center mb-2">
                                <i class="fas fa-lightbulb text-blue-500 mr-2"></i>
                                <span class="font-semibold text-blue-800">Study Recommendation</span>
                            </div>
                            <p class="text-blue-700 text-sm" id="studyInsight">
                                Encourage students to study 2+ hrs/day for better marks prediction.
                            </p>
                        </div>
                        <div class="p-4 bg-purple-50 rounded-lg border border-purple-200 cursor-pointer hover:bg-purple-100 transition" onclick="drillDownLowSleep()">
                            <div class="flex items-center mb-2">
                                <i class="fas fa-bed text-purple-500 mr-2"></i>
                                <span class="font-semibold text-purple-800">Health Tip</span>
                            </div>
                            <p class="text-purple-700 text-sm" id="sleepInsight">
                                Students sleeping &lt; 5hrs show performance drop - promote healthy habits.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- System Monitoring (Live) -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-emerald-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-chart-line text-emerald-500 mr-2"></i> System Monitoring (Live)
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="p-4 bg-emerald-50 rounded-lg border border-emerald-200">
                            <p class="text-sm text-emerald-800 font-semibold">API Requests</p>
                            <p class="text-2xl font-bold text-emerald-700" id="monitorRequests">0</p>
                        </div>
                        <div class="p-4 bg-red-50 rounded-lg border border-red-200">
                            <p class="text-sm text-red-800 font-semibold">Errors</p>
                            <p class="text-2xl font-bold text-red-700" id="monitorErrors">0</p>
                        </div>
                        <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
                            <p class="text-sm text-blue-800 font-semibold">Active Users (15m)</p>
                            <p class="text-2xl font-bold text-blue-700" id="monitorActiveUsers">0</p>
                        </div>
                        <div class="p-4 bg-purple-50 rounded-lg border border-purple-200">
                            <p class="text-sm text-purple-800 font-semibold">Running Jobs</p>
                            <p class="text-2xl font-bold text-purple-700" id="monitorJobs">0</p>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-3" id="monitorUpdatedAt">Last updated: --</p>
                    <div class="mt-3">
                        <div class="flex items-center gap-3">
                            <button id="toggleErrorsBtn" class="text-sm text-emerald-700 hover:text-emerald-900 font-medium">
                                View last errors
                            </button>
                            <button id="clearErrorsBtn" class="text-xs px-2 py-1 rounded border border-gray-300 text-gray-600 hover:bg-gray-50">
                                Clear list
                            </button>
                        </div>
                        <div id="monitorErrorsWrap" class="hidden mt-2 border rounded-lg">
                            <div id="monitorErrorsList" class="max-h-48 overflow-y-auto divide-y text-sm"></div>
                        </div>
                    </div>
                </div>

                <!-- Button Health Check -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-blue-500">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xl font-semibold flex items-center">
                            <i class="fas fa-heartbeat text-blue-500 mr-2"></i> Button Health Check
                        </h3>
                        <button id="runHealthCheckBtn" class="text-xs px-3 py-2 rounded border border-blue-300 text-blue-700 hover:bg-blue-50">
                            Run check now
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 mt-2">Auto-pings critical APIs to prove end-to-end button flows are operational.</p>
                    <div class="mt-3 flex items-center justify-between gap-3">
                        <p id="healthScoreText" class="text-sm font-semibold text-slate-700">Overall: --/-- APIs healthy</p>
                        <p class="text-xs text-gray-500">Critical checks must stay green</p>
                    </div>
                    <div id="healthCriticalBanner" class="hidden mt-3 p-3 rounded border border-red-300 bg-red-50 text-red-700 text-sm font-medium">
                        Critical endpoint failure detected. Core actions may not work right now.
                    </div>
                    <div id="healthCheckGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4"></div>
                    <p class="text-xs text-gray-500 mt-3" id="healthCheckUpdatedAt">Last checked: --</p>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-slate-500">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xl font-semibold flex items-center">
                            <i class="fas fa-clipboard-list text-slate-600 mr-2"></i> Audit Snapshot
                        </h3>
                        <div class="flex items-center gap-2">
                            <button onclick="loadAuditSnapshot()" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Refresh</button>
                            <a href="audit.html" class="text-xs px-2 py-1 border rounded hover:bg-gray-50">Open full audit</a>
                        </div>
                    </div>
                    <div id="auditSnapshotList" class="space-y-2 text-sm text-gray-700">
                        <p>Loading audit records...</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-slate-500">
                    <h3 class="text-xl font-semibold mb-4 flex items-center">
                        <i class="fas fa-comments text-slate-600 mr-2"></i> Admin Message Console
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-2">
                        <select id="adminMsgRole" class="form-input">
                            <option value="faculty">faculty</option>
                            <option value="student">student</option>
                            <option value="parent">parent</option>
                            <option value="admin">admin</option>
                        </select>
                        <input id="adminMsgRecipientId" type="number" min="1" class="form-input" placeholder="Recipient ID" />
                        <input id="adminMsgBody" class="form-input md:col-span-2" placeholder="Message..." />
                        <button onclick="sendAdminQuickMessage()" class="btn-primary">Send</button>
                    </div>
                    <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2">
                        <select id="adminRecentContacts" class="form-input" onchange="applyAdminRecentContact(this.value)">
                            <option value="">Recent contacts</option>
                        </select>
                        <p id="adminThreadUnread" class="text-xs text-gray-500 self-center">Unread in thread: 0</p>
                    </div>
                    <div class="mt-2">
                        <input id="adminThreadSearch" oninput="renderAdminThread()" class="form-input" placeholder="Search in this thread..." />
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <button onclick="loadAdminMessageThread()" class="text-xs px-2 py-1 rounded border hover:bg-gray-50">Load thread</button>
                        <button onclick="exportAdminThreadCsv()" class="text-xs px-2 py-1 rounded border hover:bg-gray-50">Export thread CSV</button>
                        <a href="messages.html" class="text-xs px-2 py-1 rounded border hover:bg-gray-50">Open full inbox</a>
                        <p id="adminMsgStatus" class="text-xs text-gray-500"></p>
                    </div>
                    <div id="adminMsgThread" class="mt-3 max-h-56 overflow-y-auto space-y-2 text-sm">
                        <p class="text-gray-500">Pick peer role/id and load thread.</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mb-8 border-l-4 border-indigo-400">
                    <h3 class="text-xl font-semibold mb-3 flex items-center">
                        <i class="fas fa-search text-indigo-500 mr-2"></i> Search Shortcuts
                    </h3>
                    <div class="flex flex-wrap gap-2 text-sm">
                        <button onclick="openSearchPreset('student')" class="px-3 py-1.5 rounded border hover:bg-gray-50">Students</button>
                        <button onclick="openSearchPreset('assignment')" class="px-3 py-1.5 rounded border hover:bg-gray-50">Assignments</button>
                        <button onclick="openSearchPreset('class')" class="px-3 py-1.5 rounded border hover:bg-gray-50">Class plans</button>
                        <button onclick="openSearchPreset('risk')" class="px-3 py-1.5 rounded border hover:bg-gray-50">Risk checks</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xl font-semibold">Attendance Trend</h3>
                            <span class="text-sm text-gray-500">Last records</span>
                        </div>
                        <canvas id="attendanceTrendChart" height="110"></canvas>
                    </div>
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xl font-semibold">Risk Distribution</h3>
                            <span class="text-sm text-gray-500">Safe / Warning / At-Risk</span>
                        </div>
                        <canvas id="riskDistributionChart" height="110"></canvas>
                    </div>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-xl font-semibold mb-4">Top Performers</h3>
                        <div id="topPerformersList" class="space-y-3">
                            <p class="text-sm text-gray-500">Loading analytics...</p>
                        </div>
                    </div>
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h3 class="text-xl font-semibold mb-4">Students Needing Support</h3>
                        <div id="supportStudentsList" class="space-y-3">
                            <p class="text-sm text-gray-500">Loading analytics...</p>
                        </div>
                    </div>
                </div>

                <!-- Recent Activities -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                    <h3 class="text-xl font-semibold mb-4">Recent Activities</h3>
                    <div class="space-y-4">
                        <div class="flex items-center space-x-4 p-3 hover:bg-gray-50 rounded-lg transition">
                            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-plus text-blue-600"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-medium">New student registered</p>
                                <p class="text-sm text-gray-500">John Doe - Computer Science Engineering</p>
                            </div>
                            <span class="text-sm text-gray-400">2 min ago</span>
                        </div>
                        
                        <div class="flex items-center space-x-4 p-3 hover:bg-gray-50 rounded-lg transition">
                            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-file-alt text-green-600"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-medium">Course updated</p>
                                <p class="text-sm text-gray-500">Machine Learning Fundamentals - AI & ML Dept</p>
                            </div>
                            <span class="text-sm text-gray-400">1 hour ago</span>
                        </div>
                        
                        <div class="flex items-center space-x-4 p-3 hover:bg-gray-50 rounded-lg transition">
                            <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-tie text-purple-600"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-medium">New faculty joined</p>
                                <p class="text-sm text-gray-500">Dr. Sarah Johnson - Pharmacy Department</p>
                            </div>
                            <span class="text-sm text-gray-400">3 hours ago</span>
                        </div>
                    </div>
                </div>

                <!-- Department Distribution -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-xl font-semibold mb-4">Department Distribution</h3>
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">425</p>
                            <p class="text-sm text-gray-600">AI & ML</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">380</p>
                            <p class="text-sm text-gray-600">Computer Science</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">320</p>
                            <p class="text-sm text-gray-600">Information Science</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">290</p>
                            <p class="text-sm text-gray-600">Civil Engineering</p>
                        </div>
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <p class="text-2xl font-bold text-blue-600">260</p>
                            <p class="text-sm text-gray-600">Electrical & Electronics</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Master Data (ERP): institutions, departments, semesters, subjects, materials -->
            <section id="masterdata" class="content-section hidden">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-3xl font-bold text-gray-800">Master Data</h2>
                        <p class="text-sm text-gray-500 mt-1">Colleges, departments, semesters, subjects, and link-only study materials (admin).</p>
                    </div>
                    <button type="button" onclick="masterDataSectionOpened()" class="text-sm px-3 py-2 rounded border border-gray-300 hover:bg-gray-50">Refresh all</button>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">
                    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
                        <h3 class="text-lg font-semibold mb-3 flex items-center"><i class="fas fa-university text-blue-500 mr-2"></i> Institutions</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-2">
                            <input id="masterInstName" class="form-input md:col-span-2" placeholder="Institution name" />
                            <input id="masterInstType" class="form-input" placeholder="Type (e.g. college)" value="college" />
                        </div>
                        <button type="button" onclick="masterCreateInstitution()" class="btn-primary mb-3">Add institution</button>
                        <p id="masterInstStatus" class="text-xs text-gray-500 mb-2"></p>
                        <div id="masterInstList" class="space-y-2 text-sm max-h-56 overflow-y-auto"></div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-emerald-500">
                        <h3 class="text-lg font-semibold mb-3 flex items-center"><i class="fas fa-sitemap text-emerald-500 mr-2"></i> Departments</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-2">
                            <select id="masterDeptInstId" class="form-input" onchange="masterRefreshDepartments()"></select>
                            <select id="masterDeptStreamFilter" class="form-input" onchange="masterRefreshDepartments()">
                                <option value="">All streams</option>
                                <option value="engineering">engineering</option>
                                <option value="medical">medical</option>
                                <option value="commerce">commerce</option>
                                <option value="general">general</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-2">
                            <input id="masterDeptName" class="form-input md:col-span-2" placeholder="Department name" />
                            <select id="masterDeptStream" class="form-input">
                                <option value="engineering">engineering</option>
                                <option value="medical">medical</option>
                                <option value="commerce">commerce</option>
                                <option value="general">general</option>
                            </select>
                        </div>
                        <button type="button" onclick="masterCreateDepartment()" class="btn-primary mb-3">Add department</button>
                        <p id="masterDeptStatus" class="text-xs text-gray-500 mb-2"></p>
                        <div id="masterDeptList" class="space-y-2 text-sm max-h-56 overflow-y-auto"></div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-amber-500">
                        <h3 class="text-lg font-semibold mb-3 flex items-center"><i class="fas fa-calendar-alt text-amber-500 mr-2"></i> Semesters</h3>
                        <select id="masterSemInstId" class="form-input mb-2" onchange="masterRefreshSemesters()"></select>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-2">
                            <input id="masterSemName" class="form-input md:col-span-2" placeholder="Semester name (e.g. Semester 1)" />
                            <input id="masterSemOrder" type="number" class="form-input" placeholder="Order" value="1" />
                        </div>
                        <button type="button" onclick="masterCreateSemester()" class="btn-primary mb-3">Add semester</button>
                        <p id="masterSemStatus" class="text-xs text-gray-500 mb-2"></p>
                        <div id="masterSemList" class="space-y-2 text-sm max-h-56 overflow-y-auto"></div>
                    </div>

                    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-violet-500">
                        <h3 class="text-lg font-semibold mb-3 flex items-center"><i class="fas fa-book text-violet-500 mr-2"></i> Subjects</h3>
                        <select id="masterSubInstId" class="form-input mb-2" onchange="masterLoadDeptOptionsForSubjects()"></select>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-2">
                            <select id="masterSubDeptId" class="form-input" onchange="masterRefreshSubjects()"></select>
                            <select id="masterSubSemId" class="form-input"><option value="">No semester</option></select>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-2 mb-2">
                            <input id="masterSubCode" class="form-input" placeholder="Code (optional)" />
                            <input id="masterSubCredits" type="number" min="1" max="10" class="form-input" placeholder="Credits" value="3" />
                            <input id="masterSubName" class="form-input md:col-span-2" placeholder="Subject name" />
                        </div>
                        <input id="masterSubSyllabus" class="form-input mb-2 w-full" placeholder="Syllabus summary (optional)" />
                        <button type="button" onclick="masterCreateSubject()" class="btn-primary mb-2">Add subject</button>
                        <button type="button" onclick="masterRefreshSubjects()" class="text-sm px-2 py-1 border rounded mb-3">List subjects</button>
                        <p id="masterSubStatus" class="text-xs text-gray-500 mb-2"></p>
                        <div id="masterSubList" class="space-y-2 text-sm max-h-56 overflow-y-auto"></div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-cyan-500">
                    <h3 class="text-lg font-semibold mb-3 flex items-center"><i class="fas fa-link text-cyan-500 mr-2"></i> Study materials (links)</h3>
                    <div class="grid grid-cols-1 lg:grid-cols-4 gap-2 mb-2">
                        <select id="masterMatDeptId" class="form-input" onchange="masterLoadSubjectsForMaterials()"></select>
                        <select id="masterMatSubjId" class="form-input lg:col-span-2" onchange="masterRefreshMaterials()"></select>
                        <select id="masterMatType" class="form-input">
                            <option value="note">note</option>
                            <option value="pdf">pdf</option>
                            <option value="ppt">ppt</option>
                            <option value="video">video</option>
                            <option value="link">link</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-2 mb-2">
                        <input id="masterMatTitle" class="form-input" placeholder="Title" />
                        <input id="masterMatUrl" class="form-input lg:col-span-2" placeholder="URL (https://...)" />
                    </div>
                    <textarea id="masterMatDesc" class="form-input w-full mb-2" rows="2" placeholder="Description (optional)"></textarea>
                    <button type="button" onclick="masterCreateMaterial()" class="btn-primary mb-2">Add material</button>
                    <button type="button" onclick="masterRefreshMaterials()" class="text-sm px-2 py-1 border rounded mb-3">Refresh list</button>
                    <p id="masterMatStatus" class="text-xs text-gray-500 mb-2"></p>
                    <div id="masterMatList" class="space-y-2 text-sm max-h-64 overflow-y-auto"></div>
                </div>
            </section>

